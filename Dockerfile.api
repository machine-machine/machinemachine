# MachineMachine API - Build from repo root
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy monorepo structure
COPY package.json pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/

# Install with frozen lockfile if exists, otherwise normal install
COPY pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install

# Copy API source
COPY packages/api ./packages/api

# Build API
WORKDIR /app/packages/api
RUN pnpm build

# Production stage
FROM node:20-alpine

WORKDIR /app

# Install pnpm for production install and db commands
RUN npm install -g pnpm

# Copy package.json and install all deps (need drizzle-kit for migrations)
COPY packages/api/package.json ./
RUN pnpm install

# Copy built files and drizzle config
COPY --from=builder /app/packages/api/dist ./dist
COPY --from=builder /app/packages/api/src/db ./src/db
COPY --from=builder /app/packages/api/drizzle.config.ts ./

# Create startup script that pushes schema then starts
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "Pushing database schema..."' >> /app/start.sh && \
    echo 'pnpm db:push || echo "Schema push failed, continuing..."' >> /app/start.sh && \
    echo 'echo "Starting API..."' >> /app/start.sh && \
    echo 'node dist/index.js' >> /app/start.sh && \
    chmod +x /app/start.sh

CMD ["/app/start.sh"]
