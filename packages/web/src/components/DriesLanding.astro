const c = copy[locale];
const mmUrl = "https://machinemachine.ai";
---

<BaseLayout title={c.title} description={c.desc}>
  <style>
    .dries-page { background: #0a0a0f; color: #e2e8f0; font-family: 'Inter', system-ui, sans-serif; }
    .section { padding: 80px 24px; max-width: 1100px; margin: 0 auto; }
    .section-wide { padding: 80px 24px; }
    .tag { display: inline-block; background: rgba(59,130,246,0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); border-radius: 20px; padding: 4px 14px; font-size: 13px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 16px; }
    h1 { font-size: clamp(2.4rem, 6vw, 4.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; }
    h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700; line-height: 1.2; }
    h3 { font-size: 1.1rem; font-weight: 700; }
    .gradient-text { background: linear-gradient(135deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .btn-primary { display: inline-block; background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; padding: 14px 28px; border-radius: 8px; font-weight: 700; font-size: 16px; text-decoration: none; transition: opacity 0.2s; }
    .btn-primary:hover { opacity: 0.85; }
    .btn-secondary { display: inline-block; border: 1px solid rgba(255,255,255,0.2); color: #e2e8f0; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 16px; text-decoration: none; margin-left: 12px; transition: border-color 0.2s; }
    .btn-secondary:hover { border-color: rgba(255,255,255,0.5); }
    .card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 28px; }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 40px; }
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 40px; }
    .step-num { font-size: 2.5rem; font-weight: 900; background: linear-gradient(135deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .arrow { text-align: center; color: #4b5563; font-size: 2rem; margin: 8px 0; }
    .compare-table { width: 100%; border-collapse: collapse; margin-top: 32px; }
    .compare-table th { padding: 16px 20px; text-align: left; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .compare-table th:first-child { color: #6b7280; }
    .compare-table th:last-child { color: #60a5fa; }
    .compare-table td { padding: 14px 20px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 15px; }
    .compare-table td:first-child { color: #6b7280; }
    .compare-table td:last-child { color: #e2e8f0; }
    .compare-table tr:hover td { background: rgba(255,255,255,0.02); }
    .phase-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(59,130,246,0.2); border-radius: 12px; padding: 28px; text-align: center; }
    .phase-num { font-size: 3rem; font-weight: 900; background: linear-gradient(135deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: block; margin-bottom: 8px; }
    .hero-section { min-height: 85vh; display: flex; align-items: center; padding: 80px 24px; max-width: 1100px; margin: 0 auto; }
    .cta-section { background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(139,92,246,0.1)); border-top: 1px solid rgba(255,255,255,0.06); text-align: center; padding: 100px 24px; }
    .divider { height: 1px; background: rgba(255,255,255,0.06); max-width: 1100px; margin: 0 auto; }
    .icon { font-size: 2rem; margin-bottom: 16px; }
    .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid rgba(255,255,255,0.06); position: sticky; top: 0; background: rgba(10,10,15,0.95); backdrop-filter: blur(12px); z-index: 10; }
    .nav-logo { font-weight: 900; font-size: 1.4rem; color: white; text-decoration: none; }
    .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 40px; }
    .team-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 24px; text-align: center; }
    .team-role { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 6px; }
    @media (max-width: 600px) {
      .btn-secondary { margin-left: 0; margin-top: 12px; display: block; text-align: center; }
      .compare-table { font-size: 13px; }
      .compare-table td, .compare-table th { padding: 10px 12px; }
    }
  </style>

  <div class="dries-page">
    <!-- Nav -->
    <nav class="nav">
      <a href="/" class="nav-logo">M²</a>
      <a href={mmUrl} class="btn-primary" style="padding: 10px 20px; font-size: 14px;">{c.hero_cta2}</a>
    </nav>

    <!-- Hero -->
    <div class="hero-section">
      <div>
        <div class="tag">Dries Cleaning × Machine.Machine</div>
        <h1>{c.hero_h1}<br/><span class="gradient-text">{c.hero_h1b}</span></h1>
        <p style="font-size: 1.2rem; color: #94a3b8; max-width: 600px; margin: 24px 0 40px; line-height: 1.7;">{c.hero_sub}</p>
        <a href="#how" class="btn-primary">{c.hero_cta}</a>
        <a href={mmUrl} class="btn-secondary">{c.hero_cta2}</a>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Problem -->
    <div class="section">
      <div class="tag">Problem</div>
      <h2>{c.prob_h}</h2>
      <p style="color: #94a3b8; margin: 16px 0 0; font-size: 1.05rem;">{c.prob_sub}</p>
      <div class="grid-3">
        <div class="card">
          <div class="icon">🔍</div>
          <h3>{c.prob1_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6;">{c.prob1}</p>
        </div>
        <div class="card">
          <div class="icon">📞</div>
          <h3>{c.prob2_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6;">{c.prob2}</p>
        </div>
        <div class="card">
          <div class="icon">🛠️</div>
          <h3>{c.prob3_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6;">{c.prob3}</p>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Solution -->
    <div class="section" style="text-align: center;">
      <div class="tag">Solution</div>
      <h2>{c.sol_h}</h2>
      <p style="color: #94a3b8; font-size: 1.15rem; max-width: 700px; margin: 24px auto 0; line-height: 1.8;">{c.sol_sub}</p>
    </div>

    <div class="divider"></div>

    <!-- How it works -->
    <div class="section" id="how">
      <div class="tag">Process</div>
      <h2>{c.how_h}</h2>
      <div class="grid-3" style="margin-top: 40px;">
        <div class="card">
          <div class="step-num">01</div>
          <h3 style="margin-top: 8px;">{c.how1_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6;">{c.how1}</p>
        </div>
        <div class="card">
          <div class="step-num">02</div>
          <h3 style="margin-top: 8px;">{c.how2_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6;">{c.how2}</p>
        </div>
        <div class="card">
          <div class="step-num">03</div>
          <h3 style="margin-top: 8px;">{c.how3_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6;">{c.how3}</p>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Industries -->
    <div class="section">
      <div class="tag">Industries</div>
      <h2>{c.ind_h}</h2>
      <div class="grid-4">
        <div class="card">
          <div class="icon">🥩</div>
          <h3>{c.ind1_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6; font-size: 14px;">{c.ind1}</p>
        </div>
        <div class="card">
          <div class="icon">⚙️</div>
          <h3>{c.ind2_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6; font-size: 14px;">{c.ind2}</p>
        </div>
        <div class="card">
          <div class="icon">🏛️</div>
          <h3>{c.ind3_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6; font-size: 14px;">{c.ind3}</p>
        </div>
        <div class="card">
          <div class="icon">🏗️</div>
          <h3>{c.ind4_t}</h3>
          <p style="color: #94a3b8; margin-top: 8px; line-height: 1.6; font-size: 14px;">{c.ind4}</p>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <!-- AI Team -->
    <div class="section">
      <div class="tag">Team</div>
      <h2>{c.team_h}</h2>
      <p style="color: #94a3b8; margin-top: 12px;">{c.team_sub}</p>
      <div class="team-grid">
        <div class="team-card">
          <div style="font-size: 2rem;">📣</div>
          <h3 style="margin-top: 12px;">AI Marketing Director</h3>
          <div class="team-role">Campaign Strategy</div>
        </div>
        <div class="team-card">
          <div style="font-size: 2rem;">📥</div>
          <h3 style="margin-top: 12px;">Sales Bot A</h3>
          <div class="team-role">Inbound Calls</div>
        </div>
        <div class="team-card">
          <div style="font-size: 2rem;">🤝</div>
          <h3 style="margin-top: 12px;">Sales Bot B</h3>
          <div class="team-role">Negotiations</div>
        </div>
        <div class="team-card">
          <div style="font-size: 2rem;">🧑‍🔧</div>
          <h3 style="margin-top: 12px;">Field Tech + AI</h3>
          <div class="team-role">Pocket Assistant</div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Comparison -->
    <div class="section">
      <div class="tag">Comparison</div>
      <h2>{c.comp_h}</h2>
      <table class="compare-table">
        <thead>
          <tr>
            <th>{c.comp_old}</th>
            <th>{c.comp_new}</th>
          </tr>
        </thead>
        <tbody>
          {c.comp_rows.map(([old, neu]) => (
            <tr>
              <td>❌ {old}</td>
              <td>✅ {neu}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="divider"></div>

    <!-- Phases -->
    <div class="section">
      <div class="tag">Roadmap</div>
      <h2>{c.phases_h}</h2>
      <div class="grid-3" style="margin-top: 40px;">
        <div class="phase-card">
          <span class="phase-num">1</span>
          <div style="font-size: 11px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">{c.phase1_t}</div>
          <h3>{c.phase1}</h3>
        </div>
        <div class="phase-card">
          <span class="phase-num">2</span>
          <div style="font-size: 11px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">{c.phase2_t}</div>
          <h3>{c.phase2}</h3>
        </div>
        <div class="phase-card">
          <span class="phase-num">3</span>
          <div style="font-size: 11px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">{c.phase3_t}</div>
          <h3>{c.phase3}</h3>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <div class="tag">Machine.Machine</div>
      <h2 style="margin-top: 8px;">{c.cta_h}</h2>
      <p style="color: #94a3b8; font-size: 1.1rem; margin: 20px auto; max-width: 500px;">{c.cta_sub}</p>
      <a href={mmUrl} class="btn-primary" style="font-size: 18px; padding: 16px 36px;">{c.cta_btn}</a>
    </div>
  </div>
</BaseLayout>
