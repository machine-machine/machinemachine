    s2_p: "Der Markt für Trockeneisstrahlen ist stark fragmentiert. Die meisten Betreiber sind kleine regionale Unternehmen ohne digitale Präsenz, ohne automatisierten Vertrieb und mit begrenzter Skalierbarkeit. Diese Lücke nutzt Dries.",
    comp_h: "Wichtigste Wettbewerber",
    comp_cols: ["Unternehmen","Region","Größe","KI / Automatisierung","Schwäche"],
    comp_rows: [
      ["Cold Jet (USA/EU)","Pan-europäisch","Groß (Gerätehersteller + Dienstleistungen)","MINIMAL","Fokus auf Geräteverkauf, nicht Dienstleistungserbringung. Hohe Preise."],
      ["IceTech (Dänemark)","EU-weit","Mittel","KEINE","Nur Gerätehersteller. Keine KI-Vertriebsschicht. Nur manuelles B2B."],
      ["Lokale DE-Betreiber","Brandenburg, Berlin","Klein (1–5 Techniker)","KEINE","Kein SEO, nur Telefonverkauf, kein CRM, keine Follow-up-Automatisierung."],
      ["Lokale PL-Betreiber","Lubuskie, Großpolen","Klein (1–3 Techniker)","KEINE","Keine grenzüberschreitende Kapazität, auf PL-Markt beschränkt, keine englischen/deutschen Materialien."],
      ["Chemische Reinigungsunternehmen","Regional","Mittel–Groß","NUR CRM","Veralteter chemiebasierter Ansatz. Verlieren regulatorische Gunst in Lebensmittel & Pharma."],
    ],
    pos_h: "Wettbewerbspositionierung",
    adv_h: "✅ Vorteile von Dries",
    adv: ["KI-Verkaufsroboter — 24/7 Lead-Betreuung, kein Personal","Dual-Marktzugang (PL-Kostenbasis + DE-Preise)","Automatisierte Lead-Generierung und -Pflege","Pocket-Assistent für Techniker = schnellere Entscheidungen vor Ort","First Mover bei KI-Automatisierung in dieser Nische","Förderfähigkeit durch EU Interreg"],
    risk_h: "⚠️ Zu beobachtende Risiken",
    risks_comp: ["Cold Jet / IceTech könnte KI-Vertriebsschicht hinzufügen","CO₂-Lieferketten-Abhängigkeit (Preisvolatilität)","Deutscher Markt erfordert GmbH + CE-Zertifizierungen","Anfangskapital für Geräte (Maschine: €15–€50k)","Vertrauenslücke: Industriekunden akzeptieren KI-Verhandlung langsam"],
    s3_tag: "03 — Businessplan",
    s3_h: "5-Jahres-Finanzprognosen",
    s3_p: "Konservatives Modell. Basis in Lubuskie, grenzüberschreitende DE-Expansion in Jahr 2, zweite Maschine in Jahr 3, Franchise-/Lizenzmodell ab Jahr 4.",
    model_box: "<strong>Umsatzmodell:</strong> Serviceaufträge (€600–€8.000 je Auftrag) gebucht durch KI-Verkaufsroboter. Betriebskosten: CO₂-Pellets (~€3–5/kg), Geräteabschreibung, 1–2 Techniker in Jahr 1 auf 4–6 bis Jahr 5 skalierend. Machine.Machine-Automatisierungsgebühr: feste monatliche Pauschale + % des inkrementellen Umsatzwachstums.",
    years: [
      { label: "Jahr 1 — 2025", rev: "€120T", title: "Aufbauphase", body: "Nur PL-Markt. 1 Maschine, 1 Techniker + KI-Verkaufsbot. ~60 Aufträge à Ø €2.000. Fokus: Lebensmittel & Industrie. KI-Bot bearbeitet alle eingehenden Anfragen. CRM live.", net: "Netto: ~€35T", costs: "Kosten: ~€85T" },
      { label: "Jahr 2 — 2026", rev: "€290T", title: "DE-Expansion", body: "Grenzüberschreitende DE-Kunden. GmbH registriert. 2 Techniker, KI-Marketing live. ~130 Aufträge à Ø €2.200. Pharma + Automotive hinzugefügt.", net: "Netto: ~€95T", costs: "Kosten: ~€195T" },
      { label: "Jahr 3 — 2027", rev: "€580T", title: "Skalierungsphase", body: "2. Maschine. 4 Techniker. KI-Pocket-Assistent für Außendienst. Laufende Verträge mit 3–5 großen Industriekunden. ~240 Aufträge à Ø €2.400.", net: "Netto: ~€210T", costs: "Kosten: ~€370T" },
      { label: "Jahr 4 — 2028", rev: "€1,1 Mio.", title: "Lizenzmodell", body: "Franchise-Handbuch an 2 Partnerunternehmer verkauft. KI-Stack lizenziert. 6 Techniker Eigenbetrieb + 2 Franchisenehmer. Wiederkehrende Einnahmen aus Jahresverträgen +30%.", net: "Netto: ~€420T", costs: "Kosten: ~€680T" },
      { label: "Jahr 5 — 2029", rev: "€2,0 Mio.", title: "Regionaler Marktführer", body: "5 Franchise-Partner in PL/DE/CZ. Eigenbetrieb: 3 Maschinen, 8 Techniker. KI-Stack vollständig autonom. Exit / PE-Übernahmeziel.", net: "Netto: ~€900T", costs: "Kosten: ~€1,1 Mio." },
    ],
    invest_h: "Erforderliches Startkapital",
    invest_cols: ["Position","Kosten (Schätz.)","Anmerkungen"],
    invest_rows: [
      ["Trockeneis-Strahlmaschine (1x)","€18.000–€45.000","Cold Jet, IceTech oder Karcher. Leasing verfügbar."],
      ["CO₂-Pellet-Vorrat (3 Monate)","€4.000–€8.000","Vertrag mit Air Products oder Messer"],
      ["Transporter","€8.000–€20.000","Gebrauchter Mercedes Sprinter für Jahr 1 ausreichend"],
      ["GmbH-Registrierung (DE)","€1.500–€3.000","Jahr 2 — erforderlich für DE-Rechnungsstellung"],
      ["Zertifizierungen (CE, HACCP-Schulung)","€2.000–€5.000","Erforderlich für Lebensmittel- & Pharmaverträge"],
      ["Machine.Machine KI-Stack-Setup","Monatliche Pauschale","Verkaufsbot, Marketing-KI, Pocket-Assistent"],
      ["Gesamtkapitalbedarf Jahr 1","€35.000–€80.000","Untere Grenze mit Geräteleasing"],
    ],
    fund_h: "Finanzierungsquellen",
    f1_t: "EU Interreg PL-BB", f1: "Grenzüberschreitende Unternehmensförderung für PL/DE-KMU. Lubuskie–Brandenburg-Programm zielt auf Industriedienstleistungen. Bis zu 85% Kofinanzierung.",
    f2_t: "PFR / BGK Darlehen (PL)", f2: "KMU-Darlehen des Polnischen Entwicklungsfonds zu 2–4% Zinsen. BGK hat spezifische Grüntechnologie-Programme.",
    f3_t: "Geräteleasing", f3: "Cold Jet und IceTech bieten Leasingprogramme. Reduziert Startkapital auf €5–15T.",
    riskm_h: "Wichtigste Risiken & Gegenmaßnahmen",
    risk_rows: [
      { icon: "🧊", t: "CO₂-Lieferunterbrechung", m: "Mehrlieferantenverträge, 30-Tage-Pufferlager, Preisklauseln in Kundenverträgen." },
      { icon: "🤖", t: "Vertrauenslücke KI-Vertrieb", m: "Menschliche Übergabe für hochwertige Aufträge (€5K+) verfügbar. KI qualifiziert, Mensch schließt ab." },
      { icon: "⚖️", t: "Deutscher Markteintritt", m: "Partnerschaft mit DE-Steuerberater ab Jahr 1. Budget €3T für rechtliche Einrichtung." },
      { icon: "📉", t: "Langsamer Start in Jahr 1", m: "KI-Bot startet Outbound ab Tag 1 und baut Pipeline 6 Wochen im Voraus auf. Ziel: 10 Pilotkunden." },
      { icon: "🏭", t: "Großer Wettbewerber setzt auf KI", m: "Früh Jahresverträge sichern. Lokaler Betreibervorteil von USA-Zentrale kaum replizierbar." },
    ],
    cta_h: "Das ist Ihre 5-Jahres-Roadmap.",
    cta_p: "Machine.Machine übernimmt den gesamten KI-Stack. Sie konzentrieren sich auf die Maschinen und die Kunden.",
    cta_btn: "Ihren KI-Agenten holen →",
    back_btn: "← Zurück zu Dries Cleaning",
  },
};

const c = t[locale];
---

<BaseLayout title={c.title} description={c.desc}>
<style>
  :root { --blue: #3b82f6; --purple: #8b5cf6; --bg: #0a0a0f; --card: rgba(255,255,255,0.04); --border: rgba(255,255,255,0.08); }
  body { background: var(--bg); color: #e2e8f0; font-family: 'Inter', system-ui, sans-serif; }
  .page { max-width: 1100px; margin: 0 auto; padding: 40px 24px 100px; }
  .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: rgba(10,10,15,0.95); backdrop-filter: blur(12px); z-index: 10; }
  .nav a { color: #94a3b8; text-decoration: none; font-size: 14px; }
  .nav a:hover { color: white; }
  .nav-logo { font-weight: 900; font-size: 1.3rem; color: white !important; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 12px; }
  h2 { font-size: 1.8rem; font-weight: 700; margin: 60px 0 8px; padding-top: 20px; }
  h3 { font-size: 1.15rem; font-weight: 700; margin: 0 0 8px; }
  .gradient { background: linear-gradient(135deg, var(--blue), var(--purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .tag { display: inline-block; background: rgba(59,130,246,0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); border-radius: 20px; padding: 4px 14px; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 20px; }
  .lead { font-size: 1.1rem; color: #94a3b8; line-height: 1.7; max-width: 780px; margin-bottom: 40px; }
  .divider { height: 1px; background: var(--border); margin: 50px 0; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 24px 28px; }
  .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 28px; }
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 28px; }
  .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 24px; }
  .stat-big { font-size: 2.6rem; font-weight: 900; background: linear-gradient(135deg, var(--blue), var(--purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1; }
  .stat-label { font-size: 13px; color: #6b7280; margin-top: 6px; line-height: 1.4; }
  .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 24px; text-align: center; }
  table { width: 100%; border-collapse: collapse; margin-top: 24px; font-size: 14px; }
  th { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); color: #6b7280; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
  td { padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.04); line-height: 1.5; }
  tr:hover td { background: rgba(255,255,255,0.02); }
  .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; }
  .badge-green { background: rgba(34,197,94,0.15); color: #4ade80; }
  .badge-yellow { background: rgba(234,179,8,0.15); color: #facc15; }
  .badge-red { background: rgba(239,68,68,0.15); color: #f87171; }
  .badge-blue { background: rgba(59,130,246,0.15); color: #60a5fa; }
  .progress-wrap { margin-top: 8px; }
  .progress-bar { height: 6px; background: rgba(255,255,255,0.08); border-radius: 4px; overflow: hidden; margin-top: 4px; }
  .progress-fill { height: 100%; background: linear-gradient(90deg, var(--blue), var(--purple)); border-radius: 4px; }
  .highlight-box { border: 1px solid rgba(59,130,246,0.3); background: rgba(59,130,246,0.06); border-radius: 12px; padding: 24px 28px; margin: 24px 0; }
  .year-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
  .year-label { font-size: 11px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
  .year-rev { font-size: 1.8rem; font-weight: 800; background: linear-gradient(135deg, var(--blue), var(--purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 4px 0; }
  .year-detail { font-size: 13px; color: #6b7280; line-height: 1.6; margin-top: 8px; }
  .risk-row { display: flex; align-items: flex-start; gap: 16px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
  .risk-icon { font-size: 1.4rem; flex-shrink: 0; margin-top: 2px; }
  .cta-section { background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(139,92,246,0.1)); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 60px 40px; text-align: center; margin-top: 60px; }
  .btn-primary { display: inline-block; background: linear-gradient(135deg, var(--blue), var(--purple)); color: white; padding: 14px 32px; border-radius: 8px; font-weight: 700; font-size: 15px; text-decoration: none; }
  .btn-outline { display: inline-block; border: 1px solid rgba(255,255,255,0.2); color: #e2e8f0; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 15px; text-decoration: none; margin-left: 12px; }
  @media (max-width: 600px) { .btn-outline { margin-left: 0; margin-top: 10px; display: block; } }
</style>
</style>

<div style="background: #0a0a0f; min-height: 100vh;">
<nav class="nav">
  <a href="/" class="nav-logo">M²</a>
  <div style="display:flex;gap:20px;align-items:center;">
    <a href={backHref}>{c.back_btn}</a>
    <a href={mmUrl} class="btn-primary" style="padding:8px 18px;font-size:13px;">{c.cta_btn}</a>
  </div>
</nav>

<div class="page">
  <div style="margin-top: 20px;">
    <div class="tag">{c.badge}</div>
    <h1>{c.h1a}<br/>&amp; <span class="gradient">{c.h1b}</span></h1>
    <p class="lead">{c.lead}</p>
  </div>

  <!-- ─── MARKET ANALYSIS ─── -->
  <div class="divider"></div>
  <div class="tag">{c.s1_tag}</div>
  <h2>{c.s1_h}</h2>
  <p style="color:#94a3b8;line-height:1.7;max-width:780px;">{c.s1_p}</p>

  <div class="grid-4" style="margin-top:28px;">
    <div class="stat-card"><div class="stat-big">{c.stat1_v}</div><div class="stat-label">{c.stat1_l}</div></div>
    <div class="stat-card"><div class="stat-big">{c.stat2_v}</div><div class="stat-label">{c.stat2_l}</div></div>
    <div class="stat-card"><div class="stat-big">{c.stat3_v}</div><div class="stat-label">{c.stat3_l}</div></div>
    <div class="stat-card"><div class="stat-big">{c.stat4_v}</div><div class="stat-label">{c.stat4_l}</div></div>
  </div>

  <h3 style="margin-top:40px;">{c.drivers_h}</h3>
  <div class="grid-3">
    <div class="card"><div style="font-size:1.6rem;margin-bottom:10px;">🏭</div><h3>{c.d1_t}</h3><p style="color:#94a3b8;font-size:14px;line-height:1.6;margin-top:6px;">{c.d1}</p></div>
    <div class="card"><div style="font-size:1.6rem;margin-bottom:10px;">♻️</div><h3>{c.d2_t}</h3><p style="color:#94a3b8;font-size:14px;line-height:1.6;margin-top:6px;">{c.d2}</p></div>
    <div class="card"><div style="font-size:1.6rem;margin-bottom:10px;">📈</div><h3>{c.d3_t}</h3><p style="color:#94a3b8;font-size:14px;line-height:1.6;margin-top:6px;">{c.d3}</p></div>
  </div>

  <h3 style="margin-top:40px;">{c.seg_h}</h3>
  <table>
    <thead><tr>{c.seg_cols.map(col => <th>{col}</th>)}</tr></thead>
    <tbody>
      {c.seg_rows.map(([seg, val, avg, freq, prio]) => (
        <tr>
          <td>{seg}</td><td>{val}</td><td>{avg}</td><td>{freq}</td>
          <td><span class={`badge badge-${prio === 'HIGH' || prio === 'WYSOKI' || prio === 'HOCH' ? 'green' : prio === 'MEDIUM' || prio === 'ŚREDNI' || prio === 'MITTEL' ? 'blue' : 'yellow'}`}>{prio}</span></td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="highlight-box" style="margin-top:32px;" set:html={c.border_box} />

  <!-- ─── COMPETITIVE LANDSCAPE ─── -->
  <div class="divider"></div>
  <div class="tag">{c.s2_tag}</div>
  <h2>{c.s2_h}</h2>
  <p style="color:#94a3b8;line-height:1.7;max-width:780px;">{c.s2_p}</p>

  <h3 style="margin-top:32px;">{c.comp_h}</h3>
  <table>
    <thead><tr>{c.comp_cols.map(col => <th>{col}</th>)}</tr></thead>
    <tbody>
      {c.comp_rows.map(([name, region, scale, ai, weakness]) => (
        <tr>
          <td><strong>{name}</strong></td><td>{region}</td><td>{scale}</td>
          <td><span class={`badge badge-${ai === 'NONE' || ai === 'BRAK' || ai === 'KEINE' ? 'red' : ai === 'MINIMAL' || ai === 'MINIMALNA' ? 'yellow' : 'blue'}`}>{ai}</span></td>
          <td style="color:#94a3b8;font-size:13px;">{weakness}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h3 style="margin-top:40px;">{c.pos_h}</h3>
  <div class="grid-2" style="margin-top:20px;">
    <div class="card">
      <h3 style="color:#4ade80;">{c.adv_h}</h3>
      <ul style="color:#94a3b8;line-height:2;margin-top:12px;padding-left:20px;font-size:14px;">
        {c.adv.map(a => <li>{a}</li>)}
      </ul>
    </div>
    <div class="card">
      <h3 style="color:#f87171;">{c.risk_h}</h3>
      <ul style="color:#94a3b8;line-height:2;margin-top:12px;padding-left:20px;font-size:14px;">
        {c.risks_comp.map(r => <li>{r}</li>)}
      </ul>
    </div>
  </div>

  <!-- ─── BUSINESS PLAN ─── -->
  <div class="divider"></div>
  <div class="tag">{c.s3_tag}</div>
  <h2>{c.s3_h}</h2>
  <p style="color:#94a3b8;line-height:1.7;max-width:780px;">{c.s3_p}</p>

  <div class="highlight-box" set:html={c.model_box} />

  <div class="grid-3" style="margin-top:32px;gap:16px;">
    {c.years.map(y => (
      <div class="year-card">
        <div class="year-label">{y.label}</div>
        <div class="year-rev">{y.rev}</div>
        <div class="year-detail">
          <strong style="color:#e2e8f0;">{y.title}</strong><br/>
          {y.body}<br/><br/>
          {y.costs}<br/>
          <strong style="color:#4ade80;">{y.net}</strong>
        </div>
      </div>
    ))}
  </div>

  <h3 style="margin-top:48px;">{c.invest_h}</h3>
  <table>
    <thead><tr>{c.invest_cols.map(col => <th>{col}</th>)}</tr></thead>
    <tbody>
      {c.invest_rows.map(([item, cost, note], i) => (
        <tr>
          <td>{i === c.invest_rows.length - 1 ? <strong>{item}</strong> : item}</td>
          <td>{i === c.invest_rows.length - 1 ? <strong>{cost}</strong> : cost}</td>
          <td style="color:#94a3b8;font-size:13px;">{note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h3 style="margin-top:40px;">{c.fund_h}</h3>
  <div class="grid-3" style="margin-top:20px;">
    <div class="card"><div style="font-size:1.5rem;margin-bottom:10px;">🇪🇺</div><h3>{c.f1_t}</h3><p style="color:#94a3b8;font-size:14px;line-height:1.6;margin-top:6px;">{c.f1}</p></div>
    <div class="card"><div style="font-size:1.5rem;margin-bottom:10px;">🏦</div><h3>{c.f2_t}</h3><p style="color:#94a3b8;font-size:14px;line-height:1.6;margin-top:6px;">{c.f2}</p></div>
    <div class="card"><div style="font-size:1.5rem;margin-bottom:10px;">💼</div><h3>{c.f3_t}</h3><p style="color:#94a3b8;font-size:14px;line-height:1.6;margin-top:6px;">{c.f3}</p></div>
  </div>

  <h3 style="margin-top:40px;">{c.riskm_h}</h3>
  <div class="card" style="margin-top:20px;">
    {c.risk_rows.map((r, i) => (
      <div class="risk-row" style={i === c.risk_rows.length - 1 ? 'border-bottom:none;' : ''}>
        <div class="risk-icon">{r.icon}</div>
        <div><strong>{r.t}</strong> — <span style="color:#94a3b8;">{r.m}</span></div>
      </div>
    ))}
  </div>

  <div class="cta-section">
    <div class="tag">{c.badge}</div>
    <h2 style="margin:8px 0 16px;">{c.cta_h}</h2>
    <p style="color:#94a3b8;font-size:1.05rem;max-width:560px;margin:0 auto 32px;line-height:1.7;">{c.cta_p}</p>
    <a href={mmUrl} class="btn-primary">{c.cta_btn}</a>
    <a href={backHref} class="btn-outline">{c.back_btn}</a>
  </div>
</div>
</div>
