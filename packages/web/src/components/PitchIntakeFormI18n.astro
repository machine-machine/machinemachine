---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="pitch-form-wrapper" id="pitch-form-section">
  <form id="pitch-form" class="pitch-form">
    <!-- Audio Recorder -->
    <div class="form-group">
      <label class="form-label">
        <span class="label-icon">&#x1F399;</span>
        {t(locale, 'form_audio_label')}
      </label>
      <p class="form-hint">{t(locale, 'form_audio_hint')}</p>
      <div class="audio-recorder" id="audio-recorder">
        <button type="button" class="btn-record" id="btn-record">
          <span class="record-dot"></span>
          {t(locale, 'form_record_start')}
        </button>
        <div class="recording-controls hidden" id="recording-controls">
          <div class="recording-indicator">
            <span class="record-dot recording"></span>
            <span class="timer" id="record-timer">0:00</span>
            <span class="timer-max">/ 3:00</span>
          </div>
          <button type="button" class="btn-stop" id="btn-stop">{t(locale, 'form_record_stop')}</button>
        </div>
        <div class="playback-controls hidden" id="playback-controls">
          <audio id="audio-preview" controls></audio>
          <button type="button" class="btn-retake" id="btn-retake">{t(locale, 'form_record_retake')}</button>
        </div>
      </div>
      <input type="hidden" name="audioBase64" id="audio-data" />
    </div>

    <!-- Links -->
    <div class="form-group">
      <label class="form-label">
        <span class="label-icon">&#x1F517;</span>
        {t(locale, 'form_links_label')}
      </label>
      <p class="form-hint">{t(locale, 'form_links_hint')}</p>
      <div id="links-container">
        <div class="link-row">
          <input type="text" name="links[]" placeholder={t(locale, 'form_links_placeholder')} class="form-input" />
        </div>
      </div>
      <button type="button" class="btn-add-link" id="btn-add-link">{t(locale, 'form_links_add')}</button>
    </div>

    <!-- Text -->
    <div class="form-group">
      <label class="form-label" for="pitch-text">
        <span class="label-icon">&#x1F4DD;</span>
        {t(locale, 'form_text_label')}
      </label>
      <textarea id="pitch-text" name="text" rows="4" class="form-input form-textarea" placeholder={t(locale, 'form_text_placeholder')}></textarea>
    </div>

    <!-- Email -->
    <div class="form-group">
      <label class="form-label" for="pitch-email">
        <span class="label-icon">&#x1F4E7;</span>
        {t(locale, 'form_email_label')}
      </label>
      <input type="email" id="pitch-email" name="email" required class="form-input" placeholder={t(locale, 'form_email_placeholder')} />
    </div>

    <!-- Submit -->
    <button type="submit" class="btn btn-primary btn-submit" id="btn-submit">
      {t(locale, 'form_submit')} &rarr;
    </button>

    <!-- Messages -->
    <div class="form-message form-error hidden" id="form-error"></div>
  </form>

  <!-- Success Result -->
  <div class="pitch-result hidden" id="pitch-result">
    <div class="result-icon">&#x2705;</div>
    <h3>{t(locale, 'form_result_title')}</h3>
    <p>{t(locale, 'form_result_text')}</p>
    <a href="#" id="pitch-link" class="pitch-link" target="_blank"></a>
    <p class="result-note" set:html={t(locale, 'form_result_note')} />
  </div>
</div>

<script define:vars={{ locale, formErrorMic: t(locale, 'form_error_mic'), formErrorEmail: t(locale, 'form_error_email'), formErrorText: t(locale, 'form_error_text'), formErrorGeneric: t(locale, 'form_error_generic'), formSending: t(locale, 'form_sending'), formSubmit: t(locale, 'form_submit'), formLinksPlaceholder: t(locale, 'form_links_placeholder'), formLinksRemoveAria: t(locale, 'form_links_remove_aria') }}>
  window.__mm_form_i18n = { locale, formErrorMic, formErrorEmail, formErrorText, formErrorGeneric, formSending, formSubmit, formLinksPlaceholder, formLinksRemoveAria };
</script>

<script>
  const i18n = (window as any).__mm_form_i18n;
  const API_URL = (import.meta as any).env.PUBLIC_API_URL || 'https://api.machinemachine.ai';

  const form = document.getElementById('pitch-form') as HTMLFormElement;
  const btnRecord = document.getElementById('btn-record') as HTMLButtonElement;
  const btnStop = document.getElementById('btn-stop') as HTMLButtonElement;
  const btnRetake = document.getElementById('btn-retake') as HTMLButtonElement;
  const btnAddLink = document.getElementById('btn-add-link') as HTMLButtonElement;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
  const recordingControls = document.getElementById('recording-controls') as HTMLDivElement;
  const playbackControls = document.getElementById('playback-controls') as HTMLDivElement;
  const audioPreview = document.getElementById('audio-preview') as HTMLAudioElement;
  const audioDataInput = document.getElementById('audio-data') as HTMLInputElement;
  const timerDisplay = document.getElementById('record-timer') as HTMLSpanElement;
  const linksContainer = document.getElementById('links-container') as HTMLDivElement;
  const formError = document.getElementById('form-error') as HTMLDivElement;
  const pitchResult = document.getElementById('pitch-result') as HTMLDivElement;
  const pitchLink = document.getElementById('pitch-link') as HTMLAnchorElement;

  let mediaRecorder: MediaRecorder | null = null;
  let audioChunks: Blob[] = [];
  let timerInterval: number | null = null;
  let seconds = 0;
  const MAX_SECONDS = 180;

  // --- Audio Recording ---
  btnRecord.addEventListener('click', async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
      audioChunks = [];
      seconds = 0;

      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0) audioChunks.push(e.data);
      };

      mediaRecorder.onstop = () => {
        stream.getTracks().forEach(t => t.stop());
        const blob = new Blob(audioChunks, { type: 'audio/webm' });
        audioPreview.src = URL.createObjectURL(blob);

        const reader = new FileReader();
        reader.onloadend = () => {
          const base64 = (reader.result as string).split(',')[1];
          audioDataInput.value = base64;
        };
        reader.readAsDataURL(blob);

        recordingControls.classList.add('hidden');
        playbackControls.classList.remove('hidden');
        if (timerInterval) clearInterval(timerInterval);
      };

      mediaRecorder.start();
      btnRecord.classList.add('hidden');
      recordingControls.classList.remove('hidden');
      if (typeof window.ph === 'function') window.ph('form_audio_started');

      timerInterval = window.setInterval(() => {
        seconds++;
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        timerDisplay.textContent = `${m}:${s.toString().padStart(2, '0')}`;
        if (seconds >= MAX_SECONDS) {
          mediaRecorder?.stop();
        }
      }, 1000);
    } catch {
      formError.textContent = i18n.formErrorMic;
      formError.classList.remove('hidden');
    }
  });

  btnStop.addEventListener('click', () => {
    mediaRecorder?.stop();
    if (typeof window.ph === 'function') window.ph('form_audio_recorded', { duration_sec: seconds });
  });

  btnRetake.addEventListener('click', () => {
    audioDataInput.value = '';
    audioPreview.src = '';
    playbackControls.classList.add('hidden');
    btnRecord.classList.remove('hidden');
  });

  // --- Links ---
  btnAddLink.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'link-row';
    row.innerHTML = `
      <input type="text" name="links[]" placeholder="${i18n.formLinksPlaceholder}" class="form-input" />
      <button type="button" class="btn-remove-link" aria-label="${i18n.formLinksRemoveAria}">&times;</button>
    `;
    row.querySelector('.btn-remove-link')?.addEventListener('click', () => row.remove());
    linksContainer.appendChild(row);
  });

  // --- PostHog: form field focus tracking ---
  var fieldsSeen = {};
  ['pitch-email', 'pitch-text'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('focus', function() {
      if (!fieldsSeen[id] && typeof window.ph === 'function') {
        fieldsSeen[id] = true;
        window.ph('form_field_focused', { field: id });
      }
    });
  });
  // Track first link input focus
  linksContainer.addEventListener('focusin', function(e) {
    if (e.target.name === 'links[]' && !fieldsSeen['links'] && typeof window.ph === 'function') {
      fieldsSeen['links'] = true;
      window.ph('form_field_focused', { field: 'links' });
    }
  });

  // --- Submit ---
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');

    const email = (document.getElementById('pitch-email') as HTMLInputElement).value.trim();
    const text = (document.getElementById('pitch-text') as HTMLTextAreaElement).value.trim();
    const linkInputs = document.querySelectorAll<HTMLInputElement>('input[name="links[]"]');
    const links = Array.from(linkInputs)
      .map(i => {
        let v = i.value.trim();
        if (v && !v.startsWith('http://') && !v.startsWith('https://')) v = 'https://' + v;
        return v;
      })
      .filter(Boolean);
    const audioBase64 = audioDataInput.value || undefined;

    if (!email) {
      formError.textContent = i18n.formErrorEmail;
      formError.classList.remove('hidden');
      return;
    }

    if (!text && links.length === 0 && !audioBase64) {
      formError.textContent = i18n.formErrorText;
      formError.classList.remove('hidden');
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.textContent = i18n.formSending;

    try {
      const body: Record<string, unknown> = { email, text, links, locale: i18n.locale };
      if (audioBase64) body.audioBase64 = audioBase64;

      const res = await fetch(`${API_URL}/v1/pitch/submit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (!res.ok) throw new Error(`Server error: ${res.status}`);

      const data = await res.json();
      const uuid = data.uuid || data.id;

      if (typeof window.ph === 'function') {
        window.ph('pitch_submitted', {
          uuid: uuid,
          has_audio: !!audioBase64,
          has_links: links.length > 0,
          has_text: !!text,
          link_count: links.length,
          text_length: text.length,
          locale: i18n.locale,
        });
      }

      // Build pitch URL with locale prefix
      const localePrefix = i18n.locale === 'en' ? '' : `/${i18n.locale}`;
      const pitchUrl = `${window.location.origin}${localePrefix}/pitch/${uuid}`;

      window.location.href = pitchUrl;
    } catch (err: any) {
      formError.textContent = i18n.formErrorGeneric;
      formError.classList.remove('hidden');
      btnSubmit.disabled = false;
      btnSubmit.textContent = i18n.formSubmit + ' \u2192';
    }
  });
</script>

<style>
  .pitch-form-wrapper {
    max-width: 640px;
    margin: 0 auto;
  }

  .pitch-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--light, #e5e7eb);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .label-icon {
    font-size: 1.2rem;
  }

  .form-hint {
    font-size: 0.9rem;
    color: var(--gray, #6b7280);
    margin-bottom: 0.25rem;
  }

  .form-input {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border, #1f2937);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    color: var(--light, #e5e7eb);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    transition: border-color 0.2s;
    width: 100%;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--primary, #3b82f6);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  /* Audio Recorder */
  .audio-recorder {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn-record {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 8px;
    color: #f87171;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    width: fit-content;
  }

  .btn-record:hover {
    background: rgba(239, 68, 68, 0.2);
  }

  .record-dot {
    width: 10px;
    height: 10px;
    background: #ef4444;
    border-radius: 50%;
    display: inline-block;
  }

  .record-dot.recording {
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .recording-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .recording-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: #f87171;
    font-weight: 600;
  }

  .timer-max {
    color: var(--gray, #6b7280);
    font-weight: 400;
  }

  .btn-stop {
    padding: 0.5rem 1rem;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 6px;
    color: #f87171;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-stop:hover {
    background: rgba(239, 68, 68, 0.3);
  }

  .playback-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .playback-controls audio {
    flex: 1;
    min-width: 200px;
    height: 36px;
  }

  .btn-retake {
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border, #1f2937);
    border-radius: 6px;
    color: var(--gray, #6b7280);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-retake:hover {
    border-color: var(--primary, #3b82f6);
    color: var(--light, #e5e7eb);
  }

  /* Links */
  .link-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .link-row .form-input {
    flex: 1;
  }

  .btn-remove-link {
    background: none;
    border: 1px solid var(--border, #1f2937);
    border-radius: 6px;
    color: var(--gray, #6b7280);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.75rem;
    transition: all 0.2s;
  }

  .btn-remove-link:hover {
    border-color: #ef4444;
    color: #f87171;
  }

  .btn-add-link {
    background: none;
    border: none;
    color: var(--primary, #3b82f6);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.25rem 0;
    transition: opacity 0.2s;
    width: fit-content;
  }

  .btn-add-link:hover {
    opacity: 0.8;
  }

  /* Submit */
  .btn-submit {
    width: 100%;
    justify-content: center;
    font-size: 1.1rem;
    padding: 1rem 2rem;
    margin-top: 0.5rem;
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
  }

  /* Messages */
  .form-message {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    text-align: center;
  }

  .form-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
  }

  /* Result Panel */
  .pitch-result {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--surface, rgba(255, 255, 255, 0.02));
    border: 1px solid var(--border, #1f2937);
    border-radius: 12px;
  }

  .result-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .pitch-result h3 {
    font-size: 1.5rem;
    color: var(--light, #e5e7eb);
    margin-bottom: 0.75rem;
  }

  .pitch-result p {
    color: var(--gray, #6b7280);
    margin-bottom: 1rem;
  }

  .pitch-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 8px;
    color: var(--primary, #3b82f6) !important;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    word-break: break-all;
  }

  .pitch-link:hover {
    background: rgba(59, 130, 246, 0.2);
  }

  .result-note {
    font-size: 0.9rem;
    color: var(--gray, #6b7280);
    line-height: 1.6;
  }

  /* Utility */
  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .pitch-form-wrapper {
      padding: 0 0.5rem;
    }

    .playback-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .playback-controls audio {
      width: 100%;
    }
  }
</style>
