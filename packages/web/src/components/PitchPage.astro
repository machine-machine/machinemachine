---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const homeHref = locale === 'en' ? '/' : `/${locale}`;
const pitchFormHref = locale === 'en' ? '/#pitch-form' : `/${locale}#pitch-form`;
---

<BaseLayout title={t(locale, 'pitch_page_title')} description={t(locale, 'pitch_page_desc')}>
  <div class="pitch-page">
    <div class="pitch-container">
      <!-- Loading State -->
      <div id="state-loading" class="pitch-state">
        <a href={homeHref} class="logo-link">M&sup2;</a>
        <div class="spinner"></div>
        <h1>{t(locale, 'pitch_loading')}</h1>
        <p>{t(locale, 'pitch_loading_sub')}</p>
      </div>

      <!-- Generating State -->
      <div id="state-generating" class="pitch-state hidden">
        <a href={homeHref} class="logo-link">M&sup2;</a>

        <!-- Rotating Gears SVG -->
        <div class="gears-wrap">
          <svg class="gears-svg" viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Large gear (left, clockwise) -->
            <g class="gear-large" transform-origin="72 80">
              <circle cx="72" cy="80" r="34" stroke="#3b82f6" stroke-width="6" fill="none" opacity="0.15"/>
              <circle cx="72" cy="80" r="14" stroke="#3b82f6" stroke-width="4" fill="none"/>
              <!-- Teeth -->
              <rect x="68" y="38" width="8" height="14" rx="2" fill="#3b82f6"/>
              <rect x="68" y="108" width="8" height="14" rx="2" fill="#3b82f6"/>
              <rect x="30" y="76" width="14" height="8" rx="2" fill="#3b82f6"/>
              <rect x="100" y="76" width="14" height="8" rx="2" fill="#3b82f6"/>
              <rect x="44" y="47" width="14" height="8" rx="2" transform="rotate(45 51 51)" fill="#3b82f6"/>
              <rect x="94" y="97" width="14" height="8" rx="2" transform="rotate(45 101 101)" fill="#3b82f6"/>
              <rect x="44" y="97" width="14" height="8" rx="2" transform="rotate(-45 51 101)" fill="#3b82f6"/>
              <rect x="94" y="47" width="14" height="8" rx="2" transform="rotate(-45 101 51)" fill="#3b82f6"/>
              <!-- Center dot -->
              <circle cx="72" cy="80" r="5" fill="#3b82f6"/>
            </g>
            <!-- Small gear (right, counter-clockwise) -->
            <g class="gear-small" transform-origin="136 60">
              <circle cx="136" cy="60" r="22" stroke="#8b5cf6" stroke-width="5" fill="none" opacity="0.15"/>
              <circle cx="136" cy="60" r="9" stroke="#8b5cf6" stroke-width="3" fill="none"/>
              <!-- Teeth -->
              <rect x="132" y="30" width="8" height="10" rx="2" fill="#8b5cf6"/>
              <rect x="132" y="80" width="8" height="10" rx="2" fill="#8b5cf6"/>
              <rect x="106" y="56" width="10" height="8" rx="2" fill="#8b5cf6"/>
              <rect x="156" y="56" width="10" height="8" rx="2" fill="#8b5cf6"/>
              <rect x="114" y="38" width="10" height="8" rx="2" transform="rotate(45 119 43)" fill="#8b5cf6"/>
              <rect x="148" y="72" width="10" height="8" rx="2" transform="rotate(45 153 77)" fill="#8b5cf6"/>
              <rect x="114" y="72" width="10" height="8" rx="2" transform="rotate(-45 119 77)" fill="#8b5cf6"/>
              <rect x="148" y="38" width="10" height="8" rx="2" transform="rotate(-45 153 43)" fill="#8b5cf6"/>
              <!-- Center dot -->
              <circle cx="136" cy="60" r="4" fill="#8b5cf6"/>
            </g>
          </svg>
        </div>

        <h1>{t(locale, 'pitch_generating')}</h1>
        <p id="generating-status-msg">{t(locale, 'pitch_generating_sub')}</p>
        <div class="progress-bar-wrap">
          <div id="progress-bar" class="progress-bar-fill" style="width:0%"></div>
        </div>
        <div id="progress-pct" class="progress-pct">0%</div>
        <div class="progress-hint">{t(locale, 'pitch_generating_hint')}</div>
        <div id="refresh-countdown" class="refresh-hint">🔄 Auto-refreshes every 20s</div>
      </div>

      <!-- Ready State -->
      <div id="state-ready" class="pitch-state hidden">
        <!-- Content will be injected here -->
      </div>

      <!-- Error State -->
      <div id="state-error" class="pitch-state hidden">
        <a href={homeHref} class="logo-link">M&sup2;</a>
        <div class="error-icon">&#x26A0;&#xFE0F;</div>
        <h1>{t(locale, 'pitch_error_title')}</h1>
        <p id="error-message">{t(locale, 'pitch_error_msg')}</p>
        <a href={homeHref} class="btn btn-primary">{t(locale, 'pitch_error_back')}</a>
      </div>

      <!-- Not Found State -->
      <div id="state-notfound" class="pitch-state hidden">
        <a href={homeHref} class="logo-link">M&sup2;</a>
        <h1>{t(locale, 'pitch_notfound_title')}</h1>
        <p>{t(locale, 'pitch_notfound_msg')}</p>
        <a href={pitchFormHref} class="btn btn-primary">{t(locale, 'pitch_notfound_cta')}</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const API_URL = (import.meta as any).env.PUBLIC_API_URL || 'https://api.machinemachine.ai';

  const stateLoading = document.getElementById('state-loading')!;
  const stateGenerating = document.getElementById('state-generating')!;
  const stateReady = document.getElementById('state-ready')!;
  const stateError = document.getElementById('state-error')!;
  const stateNotfound = document.getElementById('state-notfound')!;
  const errorMessage = document.getElementById('error-message')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressPct = document.getElementById('progress-pct')!;
  const statusMsg = document.getElementById('generating-status-msg')!;

  const STATUS_MESSAGES: [number, string][] = [
    [0,  'Analyzing your input...'],
    [20, 'Crafting your narrative...'],
    [40, 'Building slide structure...'],
    [60, 'Polishing the deck...'],
    [80, 'Almost ready...'],
    [99, 'Finishing touches...'],
  ];

  function updateProgress(pct: number) {
    progressBar.style.width = `${pct}%`;
    progressPct.textContent = `${pct}%`;
    const msg = [...STATUS_MESSAGES].reverse().find(([threshold]) => pct >= threshold);
    if (msg) statusMsg.textContent = msg[1];
  }

  // 20s hard reload countdown — fallback if API poll fails
  let reloadTimer: ReturnType<typeof setTimeout> | null = null;
  let countdownInterval: ReturnType<typeof setInterval> | null = null;
  const refreshHint = document.getElementById('refresh-countdown') as HTMLElement;

  function startReloadCountdown() {
    if (reloadTimer) return; // already started
    let secs = 20;
    if (refreshHint) refreshHint.textContent = `🔄 Refreshing in ${secs}s`;
    countdownInterval = setInterval(() => {
      secs--;
      if (refreshHint) refreshHint.textContent = `🔄 Refreshing in ${secs}s`;
      if (secs <= 0) {
        clearInterval(countdownInterval!);
        window.location.reload();
      }
    }, 1000);
    reloadTimer = setTimeout(() => window.location.reload(), 20000);
  }

  function cancelReloadCountdown() {
    if (reloadTimer) { clearTimeout(reloadTimer); reloadTimer = null; }
    if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
  }

  function showState(state: string) {
    [stateLoading, stateGenerating, stateReady, stateError, stateNotfound].forEach(el => {
      el.classList.add('hidden');
    });
    const el = document.getElementById(`state-${state}`);
    if (el) el.classList.remove('hidden');
  }

  function getUuid(): string | null {
    const pathMatch = window.location.pathname.match(/\/pitch\/([a-zA-Z0-9_-]+)/);
    if (pathMatch) return pathMatch[1];
    const params = new URLSearchParams(window.location.search);
    return params.get('id');
  }

  async function checkStatus(uuid: string) {
    try {
      const res = await fetch(`${API_URL}/v1/pitch/${uuid}/status`);

      if (res.status === 404) {
        showState('notfound');
        return;
      }

      if (!res.ok) {
        throw new Error(`Status ${res.status}`);
      }

      const data = await res.json();

      if (data.status === 'generating' || data.status === 'pending' || data.status === 'queued') {
        showState('generating');
        updateProgress(data.progress ?? 0);
        startReloadCountdown();
        setTimeout(() => checkStatus(uuid), 3000);
        return;
      }

      if (data.status === 'ready' || data.status === 'completed' || data.status === 'done') {
        cancelReloadCountdown();
        await loadPitch(uuid);
        return;
      }

      if (data.status === 'error' || data.status === 'failed') {
        if (data.message) errorMessage.textContent = data.message;
        showState('error');
        return;
      }

      showState('generating');
      setTimeout(() => checkStatus(uuid), 30000);
    } catch (err) {
      showState('error');
    }
  }

  async function loadPitch(uuid: string) {
    try {
      const res = await fetch(`${API_URL}/v1/pitch/${uuid}/html`);
      if (!res.ok) throw new Error(`Failed to load pitch: ${res.status}`);

      const html = await res.text();
      stateReady.innerHTML = html;
      showState('ready');

      const pitchPage = document.querySelector('.pitch-page') as HTMLElement;
      if (pitchPage) {
        pitchPage.style.padding = '0';
      }
      const pitchContainer = document.querySelector('.pitch-container') as HTMLElement;
      if (pitchContainer) {
        pitchContainer.style.maxWidth = 'none';
        pitchContainer.style.padding = '0';
      }

      // --- Post-injection: nav buttons + CTA cleanup ---
      const deck = document.querySelector('.deck') as HTMLElement;
      if (deck) {
        const slides = [...deck.querySelectorAll('.slide')] as HTMLElement[];
        const tgUrl = 'https://t.me/m2_onboarding_bot';
        // Remove AI-generated CTAs (not the bottom bar)
        slides.forEach(s => {
          s.querySelectorAll('a.cta').forEach(a => {
            if (!a.closest('#m2-cta-bar')) a.remove();
          });
        });
        // Add nav buttons (skip last slide — it already has a CTA from the generated HTML)
        slides.forEach((slide, i) => {
          const isLast = i === slides.length - 1;
          if (isLast) return; // don't add duplicate CTA on last slide
          const btn = document.createElement('button');
          btn.className = 'slide-nav';
          btn.textContent = 'Next \u2192';
          btn.addEventListener('click', () => {
            deck.scrollTo({ top: (slides[i + 1] as HTMLElement).offsetTop, behavior: 'smooth' });
          });
          slide.appendChild(btn);
        });
        // Enforce scroll on deck (mobile overrides handled by API-injected CSS)
        deck.style.height = '100vh';
        deck.style.overflowY = 'auto';
        deck.style.scrollSnapType = 'y mandatory';
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
      }
    } catch (err) {
      showState('error');
    }
  }

  const uuid = getUuid();
  if (!uuid) {
    showState('notfound');
  } else {
    // Track page load via parent PostHog (from BaseLayout)
    if (typeof window.ph === 'function') {
      window.ph('pitch_page_loaded', { uuid });
    }
    checkStatus(uuid);
  }
</script>

<style>
  :root {
    --primary: #3b82f6;
    --secondary: #8b5cf6;
    --dark: #0a0a0f;
    --gray: #6b7280;
    --light: #e5e7eb;
    --border: #1f2937;
  }

  .pitch-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--dark);
    padding: 2rem;
  }

  .pitch-container {
    max-width: 600px;
    width: 100%;
  }

  .pitch-state {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .logo-link {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .pitch-state h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--light);
    line-height: 1.3;
  }

  .pitch-state p {
    color: var(--gray);
    font-size: 1.1rem;
    max-width: 400px;
    line-height: 1.6;
  }

  .progress-hint {
    font-size: 0.9rem;
    color: var(--gray);
    opacity: 0.7;
    margin-top: 0.5rem;
  }

  .refresh-hint {
    font-size: 0.85rem;
    color: var(--primary);
    opacity: 0.8;
    margin-top: 0.5rem;
    letter-spacing: 0.02em;
  }

  /* Gears */
  .gears-wrap {
    margin: 0.5rem 0 1.5rem;
  }

  .gears-svg {
    width: 180px;
    height: 144px;
    overflow: visible;
  }

  .gear-large {
    animation: spin-cw 4s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .gear-small {
    animation: spin-ccw 2.67s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes spin-cw {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes spin-ccw {
    from { transform: rotate(0deg); }
    to   { transform: rotate(-360deg); }
  }

  .progress-bar-wrap {
    width: 100%;
    max-width: 400px;
    height: 8px;
    background: var(--border);
    border-radius: 99px;
    overflow: hidden;
    margin-top: 0.5rem;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    border-radius: 99px;
    transition: width 0.6s ease;
  }

  .progress-pct {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--secondary);
    margin-top: 0.25rem;
  }

  .error-icon {
    font-size: 3rem;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 3px solid var(--border);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    margin-top: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.3);
    color: white;
  }

  .hidden {
    display: none !important;
  }

  /* Hide slide-nav "Next" buttons on mobile — they cover content */
  @media (max-width: 768px) {
    :global(.slide-nav) {
      display: none !important;
    }
  }
</style>
