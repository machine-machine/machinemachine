---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={`${post.data.title} — MachineMachine`} description={post.data.description}>
  <header>
    <nav class="container">
      <a href="/" class="logo">M²</a>
      <ul class="nav-links">
        <li><a href="/#how-it-works">How It Works</a></li>
        <li><a href="/#use-cases">Use Cases</a></li>
        <li><a href="/blog" class="active">Blog</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="https://github.com/machine-machine/machinemachine">GitHub</a></li>
      </ul>
    </nav>
  </header>

  <main class="post-main">
    <div class="container">
      <div class="post-header">
        <a href="/blog" class="back-link">← All posts</a>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span class="author">by {post.data.author}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <div class="tags">
          {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </div>

      <article class="post-content">
        <Content />
      </article>

      <div class="post-footer">
        <div class="cta-box">
          <div class="cta-label">MachineMachine</div>
          <p>We're building the infrastructure for autonomous AI organizations that learn and improve their own structure.</p>
          <a href="/early-access" class="btn">Request Early Access →</a>
        </div>

        <div class="share-section">
          <span>Share</span>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=https://machinemachine.ai/blog/${post.slug}`}
             target="_blank" rel="noopener" class="share-link">LinkedIn</a>
          <a href={`https://twitter.com/intent/tweet?url=https://machinemachine.ai/blog/${post.slug}&text=${encodeURIComponent(post.data.title)}`}
             target="_blank" rel="noopener" class="share-link">X/Twitter</a>
        </div>

        <a href="/blog" class="back-link-bottom">← Back to all posts</a>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/docs">Documentation</a>
        <a href="/blog">Blog</a>
        <a href="https://github.com/machine-machine/machinemachine">GitHub</a>
      </div>
      <p class="copyright">© 2026 MachineMachine. The platform for autonomous organizations.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --primary: #3b82f6; --secondary: #8b5cf6;
    --dark: #0a0a0f; --darker: #050508;
    --gray: #6b7280; --light: #e5e7eb;
    --border: #1f2937; --surface: rgba(255,255,255,0.02);
  }
  body { background: var(--dark); color: var(--light); font-family: 'Space Grotesk', system-ui, sans-serif; line-height: 1.7; }

  .container { max-width: 740px; margin: 0 auto; padding: 0 2rem; }

  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(5,5,8,.95); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  nav { display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; max-width: 1200px; margin: 0 auto; }
  .logo { font-size: 1.5rem; font-weight: 700; text-decoration: none; background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { color: var(--light); text-decoration: none; font-weight: 500; transition: color .3s; }
  .nav-links a:hover, .nav-links a.active { color: var(--primary); }

  .post-main { padding: 8rem 0 6rem; }

  .post-header { margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }

  .back-link { display: inline-block; color: var(--gray); text-decoration: none; font-size: .9rem; margin-bottom: 1.5rem; transition: color .2s; }
  .back-link:hover { color: var(--primary); }

  .post-meta { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; }
  .post-meta time, .author { font-size: .875rem; color: var(--gray); }

  h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 700; line-height: 1.2; margin-bottom: 1rem; color: var(--light); }

  .post-description { font-size: 1.1rem; color: var(--gray); margin-bottom: 1.5rem; font-style: italic; }

  .tags { display: flex; gap: .5rem; flex-wrap: wrap; }
  .tag { padding: .2rem .7rem; background: rgba(139,92,246,.1); border: 1px solid rgba(139,92,246,.3); border-radius: 20px; font-size: .75rem; color: #a78bfa; font-weight: 600; }

  /* Post content typography */
  .post-content { font-size: 1.05rem; line-height: 1.8; }
  .post-content :global(h2) { font-size: 1.5rem; font-weight: 700; color: var(--light); margin: 2.5rem 0 1rem; }
  .post-content :global(h3) { font-size: 1.2rem; font-weight: 700; color: var(--light); margin: 2rem 0 .75rem; }
  .post-content :global(p) { color: rgba(229,231,235,.85); margin-bottom: 1.25rem; }
  .post-content :global(strong) { color: var(--light); font-weight: 600; }
  .post-content :global(em) { color: rgba(229,231,235,.7); font-style: italic; }
  .post-content :global(ul), .post-content :global(ol) { padding-left: 1.5rem; margin-bottom: 1.25rem; color: rgba(229,231,235,.85); }
  .post-content :global(li) { margin-bottom: .5rem; }
  .post-content :global(a) { color: var(--primary); text-decoration: underline; text-decoration-color: rgba(59,130,246,.4); transition: opacity .2s; }
  .post-content :global(a:hover) { opacity: .8; }
  .post-content :global(blockquote) { border-left: 3px solid var(--primary); padding: .75rem 1.5rem; margin: 1.5rem 0; background: rgba(59,130,246,.05); border-radius: 0 8px 8px 0; }
  .post-content :global(blockquote p) { margin-bottom: 0; color: rgba(229,231,235,.7); font-style: italic; }
  .post-content :global(code) { background: rgba(255,255,255,.06); padding: .15rem .4rem; border-radius: 4px; font-size: .9em; color: #a78bfa; font-family: 'Fira Code', monospace; }
  .post-content :global(pre) { background: var(--darker); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; overflow-x: auto; margin: 1.5rem 0; }
  .post-content :global(pre code) { background: none; padding: 0; color: var(--light); font-size: .9rem; }
  .post-content :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: .9rem; }
  .post-content :global(th) { background: rgba(59,130,246,.1); color: var(--primary); padding: .75rem 1rem; text-align: left; font-weight: 600; border-bottom: 1px solid var(--border); }
  .post-content :global(td) { padding: .75rem 1rem; border-bottom: 1px solid rgba(255,255,255,.05); color: rgba(229,231,235,.85); }
  .post-content :global(tr:last-child td) { border-bottom: none; }
  .post-content :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }

  .post-footer { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 2rem; }

  .cta-box { background: rgba(59,130,246,.05); border: 1px solid rgba(59,130,246,.2); border-radius: 16px; padding: 2rem; }
  .cta-label { font-size: .75rem; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .75rem; }
  .cta-box p { color: var(--gray); margin-bottom: 1.25rem; font-size: .95rem; }
  .btn { display: inline-flex; padding: .75rem 1.5rem; background: linear-gradient(135deg, var(--primary), var(--secondary)); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: .9rem; transition: opacity .2s; }
  .btn:hover { opacity: .85; }

  .share-section { display: flex; align-items: center; gap: 1rem; }
  .share-section span { color: var(--gray); font-size: .9rem; }
  .share-link { color: var(--primary); text-decoration: none; font-weight: 600; font-size: .9rem; padding: .4rem .9rem; border: 1px solid rgba(59,130,246,.3); border-radius: 6px; transition: all .2s; }
  .share-link:hover { background: rgba(59,130,246,.1); }

  .back-link-bottom { color: var(--gray); text-decoration: none; font-size: .9rem; transition: color .2s; }
  .back-link-bottom:hover { color: var(--primary); }

  footer { background: var(--darker); padding: 3rem 0; border-top: 1px solid var(--border); }
  .footer-links { display: flex; justify-content: center; gap: 2rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .footer-links a { color: var(--gray); text-decoration: none; font-weight: 500; transition: color .3s; }
  .footer-links a:hover { color: var(--primary); }
  .copyright { text-align: center; color: var(--gray); font-size: .9rem; }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    h1 { font-size: 1.6rem; }
  }
</style>
