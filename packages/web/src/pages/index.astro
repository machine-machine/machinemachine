---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Machine Machine | Organizational Intelligence Platform" description="Make your machine think. The Organizational Intelligence Platform for growth-stage tech companies. 30-day free trial.">
  <header>
    <nav class="container">
      <a href="/" class="logo">M²</a>
      <ul class="nav-links">
        <li><a href="#how-it-works">How It Works</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/docs">Documentation</a></li>
        <li><a href="https://github.com/machine-machine/machinemachine">GitHub</a></li>
      </ul>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span>⚡</span>
        <span>Organizational Intelligence Platform</span>
      </div>
      <h1>Make your machine think.</h1>
      <p class="hero-tagline">The Organizational Intelligence Platform</p>
      <p class="hero-description">
        Make your 50-person company operate like a 500-person company.<br>
        Deploy intelligent operations that learn your culture and work autonomously.
      </p>
      <div class="hero-buttons">
        <a href="#trial" class="btn btn-primary">Start 30-Day Free Trial</a>
        <a href="#how-it-works" class="btn btn-secondary">See How It Works</a>
      </div>
    </div>
  </section>

  <section class="problem">
    <div class="container">
      <h2>The Intent Gap</h2>
      <div class="problem-content">
        <div class="problem-stat">
          <span class="stat-number">$2.3T</span>
          <span class="stat-label">wasted annually on failed software implementations</span>
        </div>
        <div class="problem-description">
          <p>Organizations know what they want.</p>
          <p><strong>AI doesn't understand what they mean.</strong></p>
          <p class="gap-emphasis">This is the Intent Gap — and it's costing businesses trillions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="solution">
    <div class="container">
      <h2>Before & After</h2>
      <div class="comparison">
        <div class="comparison-side before">
          <h3>❌ Custom AI Integrations</h3>
          <ul>
            <li>6-12 months to deploy</li>
            <li>Rigid, doesn't adapt to your culture</li>
            <li>Requires constant supervision</li>
            <li>Breaks when processes change</li>
            <li>$500K+ implementation costs</li>
          </ul>
        </div>
        <div class="comparison-arrow">→</div>
        <div class="comparison-side after">
          <h3>✅ Organizational Intelligence</h3>
          <ul>
            <li>Deploy in days, not months</li>
            <li>Learns your culture and context</li>
            <li>Autonomous operations</li>
            <li>Evolves with your business</li>
            <li>Pay as you scale</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="how-it-works" id="how-it-works">
    <div class="container">
      <h2>How It Works</h2>
      <p class="section-subtitle">Four layers that understand your organization</p>
      <div class="layers-grid">
        <div class="layer">
          <div class="layer-number">1</div>
          <h3>Foundation</h3>
          <p>Secure infrastructure and APIs. Multi-model AI orchestration with enterprise-grade safety.</p>
        </div>
        <div class="layer">
          <div class="layer-number">2</div>
          <h3>Memory</h3>
          <p>Institutional knowledge that persists and grows. Your AI remembers decisions, learns patterns.</p>
        </div>
        <div class="layer">
          <div class="layer-number">3</div>
          <h3>Skills</h3>
          <p>Specialized capabilities tailored to your operations. From simple tasks to complex workflows.</p>
        </div>
        <div class="layer">
          <div class="layer-number">4</div>
          <h3>Learning</h3>
          <p>Continuous adaptation to your culture, processes, and goals. Gets smarter with every interaction.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="traction">
    <div class="container">
      <h2>Proven Results</h2>
      <div class="traction-grid">
        <div class="traction-stat">
          <span class="stat-number">12</span>
          <span class="stat-label">deployments across 4 verticals</span>
        </div>
        <div class="traction-stat">
          <span class="stat-number">$400K</span>
          <span class="stat-label">ARR baseline</span>
        </div>
        <div class="traction-stat">
          <span class="stat-number">130%</span>
          <span class="stat-label">target NRR</span>
        </div>
        <div class="traction-stat">
          <span class="stat-number">&lt;30</span>
          <span class="stat-label">days to deploy</span>
        </div>
      </div>
    </div>
  </section>

  <section class="pricing" id="pricing">
    <div class="container">
      <h2>Simple, Transparent Pricing</h2>
      <p class="pricing-subtitle">All plans include 30 days free</p>
      <div class="pricing-grid">
        <div class="pricing-card">
          <div class="pricing-header">
            <h3>Founder</h3>
            <div class="price">$1,500<span>/month</span></div>
          </div>
          <div class="pricing-features">
            <p class="pricing-description">Core operations for 1 user</p>
            <ul>
              <li>Personal Chief of Staff deployment</li>
              <li>Basic organizational memory</li>
              <li>Core skill library</li>
              <li>Email & calendar integration</li>
              <li>Community support</li>
            </ul>
          </div>
          <div class="pricing-trial">30 days free</div>
        </div>
        
        <div class="pricing-card featured">
          <div class="pricing-header">
            <h3>Executive Team</h3>
            <div class="price">$4,000<span>/month</span></div>
          </div>
          <div class="pricing-features">
            <p class="pricing-description">Up to 5 users, shared context</p>
            <ul>
              <li>Everything in Founder</li>
              <li>Shared organizational context</li>
              <li>Advanced workflow automation</li>
              <li>Custom integrations</li>
              <li>Priority support</li>
            </ul>
          </div>
          <div class="pricing-trial">30 days free</div>
        </div>
        
        <div class="pricing-card">
          <div class="pricing-header">
            <h3>Company OS</h3>
            <div class="price">$8K-$20K<span>/month</span></div>
          </div>
          <div class="pricing-features">
            <p class="pricing-description">Organization-wide intelligence</p>
            <ul>
              <li>Everything in Executive Team</li>
              <li>Unlimited users</li>
              <li>Deep system integrations</li>
              <li>Custom AI models</li>
              <li>Dedicated success manager</li>
            </ul>
          </div>
          <div class="pricing-trial">30 days free</div>
        </div>
      </div>
    </div>
  </section>

  <section class="trial" id="trial">
    <div class="container">
      <h2>Free 30-Day Chief of Staff Deployment</h2>
      <p class="trial-subtitle">Experience organizational intelligence with zero commitment</p>
      <div class="trial-form">
        <form action="/api/trial" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" required>
            </div>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="form-group">
            <label for="description">What would you like your AI Chief of Staff to help with first?</label>
            <textarea id="description" name="description" rows="4" placeholder="e.g., Managing my calendar and email, coordinating team projects, automating reporting..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-large">Start Your Free Trial</button>
        </form>
      </div>
    </div>
  </section>

  <section class="team">
    <div class="container">
      <h2>Team</h2>
      <div class="team-grid">
        <div class="team-member">
          <h3>Mariusz Ferdyn</h3>
          <p class="team-role">CEO & CTO</p>
          <p class="team-bio">Serial entrepreneur and AI researcher. Previously built and sold enterprise software companies.</p>
        </div>
        <div class="team-member">
          <h3>Peter Mühlmann</h3>
          <p class="team-role">Advisor</p>
          <p class="team-bio">Founder & former CEO of Trustpilot. $1.4B exit. Expert in scaling technology platforms.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/docs">Documentation</a>
        <a href="https://api.machinemachine.ai">API</a>
        <a href="https://github.com/machine-machine/machinemachine">GitHub</a>
        <a href="/manifesto" class="manifesto-link">Machine Manifesto</a>
      </div>
      <p class="copyright">© 2026 Machine Machine. The organizational intelligence platform.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --primary: #3b82f6;
    --secondary: #8b5cf6;
    --dark: #0a0a0a;
    --darker: #050505;
    --gray: #888;
    --light: #ccc;
    --success: #10b981;
    --warning: #f59e0b;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(5, 5, 5, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #222;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    color: var(--light);
    text-decoration: none;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: var(--primary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem 4rem;
    background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    color: var(--primary);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 4rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
  }

  .hero-tagline {
    font-size: 1.5rem;
    color: var(--gray);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--light);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    border: none;
    cursor: pointer;
    font-size: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: #fff;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid #333;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 40px rgba(59, 130, 246, 0.2);
  }

  .btn-large {
    padding: 1.25rem 2.5rem;
    font-size: 1.1rem;
    font-weight: 700;
  }

  section {
    padding: 6rem 0;
  }

  h2 {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle, .pricing-subtitle, .trial-subtitle {
    text-align: center;
    color: var(--gray);
    font-size: 1.25rem;
    margin-bottom: 3rem;
  }

  /* Problem Section */
  .problem {
    background: var(--darker);
  }

  .problem-content {
    display: flex;
    align-items: center;
    gap: 4rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .problem-stat {
    text-align: center;
    flex-shrink: 0;
  }

  .stat-number {
    display: block;
    font-size: 4rem;
    font-weight: 700;
    color: var(--warning);
    line-height: 1;
  }

  .stat-label {
    color: var(--gray);
    font-size: 0.9rem;
    display: block;
    margin-top: 0.5rem;
  }

  .problem-description {
    flex: 1;
  }

  .problem-description p {
    font-size: 1.5rem;
    line-height: 1.4;
    margin-bottom: 0.5rem;
    color: var(--light);
  }

  .gap-emphasis {
    color: var(--warning);
    font-weight: 600;
    margin-top: 1rem;
  }

  /* Solution Section */
  .comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }

  .comparison-side {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #222;
    border-radius: 12px;
    padding: 2rem;
  }

  .before {
    border-color: rgba(245, 158, 11, 0.3);
    background: rgba(245, 158, 11, 0.05);
  }

  .after {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.05);
  }

  .comparison-side h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .comparison-side ul {
    list-style: none;
    padding: 0;
  }

  .comparison-side li {
    color: var(--gray);
    margin-bottom: 0.75rem;
    padding-left: 1rem;
    position: relative;
  }

  .comparison-side li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--primary);
  }

  .comparison-arrow {
    color: var(--primary);
    font-size: 2rem;
    font-weight: 700;
  }

  /* How It Works */
  .layers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .layer {
    background: rgba(59, 130, 246, 0.05);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    position: relative;
  }

  .layer-number {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: #fff;
    font-weight: 700;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }

  .layer h3 {
    color: #fff;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .layer p {
    color: var(--gray);
    line-height: 1.6;
  }

  /* Traction */
  .traction {
    background: var(--darker);
  }

  .traction-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .traction-stat {
    text-align: center;
    padding: 2rem 1rem;
  }

  .traction-stat .stat-number {
    font-size: 3rem;
    color: var(--success);
  }

  .traction-stat .stat-label {
    font-size: 1rem;
  }

  /* Pricing */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .pricing-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #222;
    border-radius: 12px;
    padding: 2rem;
    position: relative;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(59, 130, 246, 0.1);
  }

  .featured {
    border-color: var(--primary);
    background: rgba(59, 130, 246, 0.05);
    transform: scale(1.05);
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .pricing-header h3 {
    color: #fff;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .price {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--primary);
    line-height: 1;
  }

  .price span {
    font-size: 1rem;
    color: var(--gray);
    font-weight: 400;
  }

  .pricing-description {
    color: var(--light);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .pricing-features ul {
    list-style: none;
    padding: 0;
  }

  .pricing-features li {
    color: var(--gray);
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .pricing-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--success);
    font-weight: 700;
  }

  .pricing-trial {
    background: var(--success);
    color: #000;
    text-align: center;
    padding: 0.75rem;
    border-radius: 6px;
    font-weight: 600;
    margin-top: 2rem;
  }

  /* Trial Form */
  .trial {
    background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
  }

  .trial-form {
    max-width: 600px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #222;
    border-radius: 12px;
    padding: 3rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    color: var(--light);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #333;
    border-radius: 8px;
    color: #fff;
    font-size: 1rem;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    font-family: inherit;
  }

  /* Team */
  .team {
    background: var(--darker);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
  }

  .team-member {
    text-align: center;
    padding: 2rem;
  }

  .team-member h3 {
    color: #fff;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .team-role {
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .team-bio {
    color: var(--gray);
    line-height: 1.6;
  }

  /* Footer */
  footer {
    background: var(--darker);
    padding: 3rem 0;
    border-top: 1px solid #222;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--gray);
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-links a:hover {
    color: var(--primary);
  }

  .footer-links .manifesto-link {
    color: #555;
    font-size: 0.85rem;
  }

  .footer-links .manifesto-link:hover {
    color: var(--secondary);
  }

  .copyright {
    text-align: center;
    color: #555;
    font-size: 0.9rem;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }

    .hero-tagline {
      font-size: 1.1rem;
    }

    .problem-content {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .comparison {
      grid-template-columns: 1fr;
    }

    .comparison-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .trial-form {
      padding: 2rem 1.5rem;
    }

    .nav-links {
      display: none;
    }

    .featured {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 1rem;
    }

    section {
      padding: 4rem 0;
    }

    h1 {
      font-size: 2rem;
    }

    h2 {
      font-size: 2rem;
    }

    .stat-number {
      font-size: 3rem;
    }

    .price {
      font-size: 2rem;
    }
  }
</style>