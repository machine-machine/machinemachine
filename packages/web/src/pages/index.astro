---
import BaseLayout from '../layouts/BaseLayout.astro';
import PitchIntakeForm from '../components/PitchIntakeForm.astro';
---

<BaseLayout title="MachineMachine | Dein Team. Mit KI-Verstaerkung." description="Machine.Machine gibt kleinen Teams die Kapazitaet von grossen. Ohne neue Mitarbeiter. KI-Verstaerkung fuer Documentation, Research und Kundenkommunikation.">
  <header>
    <nav class="container">
      <a href="/" class="logo">M&sup2;</a>
      <ul class="nav-links">
        <li><a href="#problem">Problem</a></li>
        <li><a href="#how-it-works">So funktioniert's</a></li>
        <li><a href="#use-cases">Anwendungen</a></li>
        <li><a href="#pitch-form">Pitch anfragen</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/docs">Docs</a></li>
      </ul>
    </nav>
  </header>

  <!-- 1. Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span>KI-Verstaerkung fuer kleine Teams</span>
      </div>
      <h1>Dein Team.<br/>Mit KI-Verstaerkung.</h1>
      <p class="hero-description">
        Machine.Machine gibt kleinen Teams die Kapazitaet von grossen.<br/>
        Ohne neue Mitarbeiter.
      </p>
      <div class="hero-buttons">
        <a href="#pitch-form" class="btn btn-primary">Jetzt bewerben &mdash; Pitch generieren lassen &darr;</a>
        <a href="#problem" class="btn btn-secondary">Mehr erfahren &rarr;</a>
      </div>
    </div>
  </section>

  <!-- 2. The real problem -->
  <section class="problem-section" id="problem">
    <div class="container">
      <h2>Dein Team macht tolle Arbeit.<br/>Und dann sitzt du stundenlang am Bericht.</h2>
      <div class="problem-cards">
        <div class="problem-card">
          <div class="problem-icon">&#x1F4AD;</div>
          <h3>Wissen geht verloren</h3>
          <p>Jemand verlaesst das Team &mdash; und nimmt die Haelfte eures Know-hows mit. Nichts davon wurde dokumentiert.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">&#x1F501;</div>
          <h3>Jedes Projekt von vorn</h3>
          <p>Ihr habt das Gleiche schon dreimal gemacht &mdash; aber jedes Mal fangt ihr bei Null an, weil niemand die alten Ergebnisse findet.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">&#x23F3;</div>
          <h3>Kapazitaet ist immer das Limit</h3>
          <p>Die Ideen sind da. Das Team ist gut. Aber der Tag hat nur 8 Stunden &mdash; und die Haelfte davon geht fuer Admin drauf.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What changes (before/after) -->
  <section class="transformation" id="transformation">
    <div class="container">
      <h2>Was sich aendert</h2>
      <p class="section-subtitle">Von einzelnen Tools zu einem KI-Team, das mit euch waechst.</p>
      <div class="comparison-table">
        <div class="comparison-column before">
          <h3>Heute: Einzelne KI-Tools</h3>
          <div class="comparison-items">
            <div class="comparison-item">Ein Agent, der isoliert arbeitet</div>
            <div class="comparison-item">Vergisst alles nach jeder Session</div>
            <div class="comparison-item">Kein Kontext ueber euer Unternehmen</div>
            <div class="comparison-item">Jedes Mal von vorn erklaeren</div>
            <div class="comparison-item">Copy &amp; Paste zwischen Tools</div>
          </div>
        </div>
        <div class="comparison-column after">
          <h3>Mit M&sup2;: KI-Organisation</h3>
          <div class="comparison-items">
            <div class="comparison-item">Mehrere Agents, die sich koordinieren</div>
            <div class="comparison-item">Erinnert sich an alles Wichtige</div>
            <div class="comparison-item">Kennt eure Standards und Sprache</div>
            <div class="comparison-item">Wird mit jedem Projekt besser</div>
            <div class="comparison-item">Ein System, das zusammenarbeitet</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. How it works (4 layers) -->
  <section class="how-it-works" id="how-it-works">
    <div class="container">
      <h2>So funktioniert's</h2>
      <p class="section-subtitle">Vier Schichten &mdash; einfach erklaert.</p>
      <div class="layers-grid">
        <div class="layer-card">
          <div class="layer-number">1</div>
          <div class="layer-content">
            <h3>Grundlage</h3>
            <p class="layer-technical">Substrate</p>
            <p>Die Infrastruktur, auf der eure KI-Agents laufen. Sicher, skalierbar, auf euren Servern oder unseren.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">2</div>
          <div class="layer-content">
            <h3>Gedaechtnis</h3>
            <p class="layer-technical">Memory</p>
            <p>Alles, was eure KI-Organisation lernt, bleibt gespeichert. Eure Standards, eure Sprache, eure Entscheidungen.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">3</div>
          <div class="layer-content">
            <h3>Faehigkeiten</h3>
            <p class="layer-technical">Skills</p>
            <p>Konkrete Aufgaben, die eure Agents beherrschen: Berichte schreiben, recherchieren, Emails beantworten.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">4</div>
          <div class="layer-content">
            <h3>Lernen</h3>
            <p class="layer-technical">Learning</p>
            <p>Nach jedem Projekt wird euer KI-Team besser. Automatisch. Ohne dass ihr etwas konfigurieren muesst.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Proof (benchmark numbers) -->
  <section class="proof-section" id="proof">
    <div class="container">
      <h2>Echte Ergebnisse. Keine Versprechen.</h2>
      <p class="section-subtitle">Gemessen an realen Projekten &mdash; nicht an Marketing-Demos.</p>
      <div class="proof-stats">
        <div class="proof-stat">
          <div class="stat-number">&minus;17</div>
          <div class="stat-label">Benchmark-Score<br/>beim ersten Durchlauf</div>
        </div>
        <div class="proof-stat highlight">
          <div class="stat-number">+11</div>
          <div class="stat-label">Benchmark-Score<br/>nach dem Lernen</div>
        </div>
        <div class="proof-stat">
          <div class="stat-number">6</div>
          <div class="stat-label">Iterationen<br/>bis zur Verbesserung</div>
        </div>
        <div class="proof-stat">
          <div class="stat-number">0</div>
          <div class="stat-label">Menschliches Eingreifen<br/>noetig</div>
        </div>
      </div>
      <p class="proof-footnote">Das System hat sich selbst verbessert &mdash; ohne dass jemand eingreifen musste. Von negativ auf positiv in 6 Runden.</p>
    </div>
  </section>

  <!-- 6. What your AI team does (3 use cases) -->
  <section class="use-cases" id="use-cases">
    <div class="container">
      <h2>Was dein KI-Team konkret macht</h2>
      <p class="section-subtitle">Drei Bereiche, in denen es sofort Kapazitaet schafft.</p>
      <div class="use-case-grid">
        <div class="use-case">
          <div class="use-case-icon">&#x1F4C4;</div>
          <h3>Dokumentation &amp; Berichte</h3>
          <p>Nachhaltigkeitsberichte, Foerderantraege, Projektdokumentationen &mdash; euer KI-Team schreibt sie in eurem Stil. Nicht generisch, sondern so wie ihr es wollt.</p>
          <div class="use-case-example">
            <span>Beispiel:</span> Ein 8-Personen-Team erstellt Nachhaltigkeitsberichte jetzt in der Haelfte der Zeit.
          </div>
        </div>
        <div class="use-case">
          <div class="use-case-icon">&#x1F50D;</div>
          <h3>Research &amp; Analyse</h3>
          <p>Marktanalysen, Wettbewerber-Recherche, regulatorische Updates &mdash; euer KI-Team recherchiert gruendlich und fasst zusammen, was fuer euch relevant ist.</p>
          <div class="use-case-example">
            <span>Beispiel:</span> Statt 2 Tage Recherche &mdash; ein strukturiertes Briefing am naechsten Morgen.
          </div>
        </div>
        <div class="use-case">
          <div class="use-case-icon">&#x1F4EC;</div>
          <h3>Kundenkommunikation</h3>
          <p>Angebotstexte, Support-Antworten, Follow-ups &mdash; in eurem Ton, mit eurem Wissen. Nicht wie ein Chatbot, sondern wie ein Teammitglied.</p>
          <div class="use-case-example">
            <span>Beispiel:</span> Kundenanfragen werden in Minuten beantwortet &mdash; konsistent und persoenlich.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. It learns -->
  <section class="learning-section">
    <div class="container">
      <div class="learning-content">
        <h2>Es lernt.</h2>
        <p class="learning-headline">Nach 50 Projekten kennt es eure Standards.<br/>Nach 200 kennt es euren Markt.</p>
        <p class="learning-body">Jedes Projekt, jedes Feedback, jede Korrektur macht euer KI-Team besser. Nicht theoretisch &mdash; messbar. Das ist der Unterschied zu Tools, die jeden Tag alles vergessen.</p>
      </div>
    </div>
  </section>

  <!-- 8. Your control -->
  <section class="control-section">
    <div class="container">
      <h2>Deine Kontrolle. Deine Daten.</h2>
      <p class="section-subtitle">Kein Lock-in. Kein Vertrauensvorschuss. Ihr bestimmt.</p>
      <div class="control-grid">
        <div class="control-card">
          <h4>Self-Hosted</h4>
          <p>Laeuft auf euren Servern. Eure Daten verlassen nie euer Netzwerk, wenn ihr das wollt.</p>
        </div>
        <div class="control-card">
          <h4>Ihr genehmigt alles</h4>
          <p>Nichts geht raus, was ihr nicht freigegeben habt. Jeder Output wird euch vorgelegt.</p>
        </div>
        <div class="control-card">
          <h4>Transparent</h4>
          <p>Ihr seht, was das System tut, warum es Entscheidungen trifft, und koennt jederzeit eingreifen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Intake form / main CTA -->
  <section class="pitch-cta" id="pitch-form">
    <div class="container">
      <h2>Lass uns deinen persoenlichen Pitch generieren</h2>
      <p class="section-subtitle">Erzaehl uns von deinem Team. In 30 Minuten bekommst du eine massgeschneiderte Praesentation.</p>
      <PitchIntakeForm />
    </div>
  </section>

  <!-- 10. Footer -->
  <footer>
    <div class="container">
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/docs">Documentation</a>
        <a href="/blog">Blog</a>
        <a href="https://github.com/machine-machine/machinemachine">GitHub</a>
      </div>
      <p class="copyright">&copy; 2026 MachineMachine. KI-Verstaerkung fuer kleine Teams.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --primary: #3b82f6;
    --secondary: #8b5cf6;
    --accent: #06d6a0;
    --dark: #0a0a0f;
    --darker: #050508;
    --gray: #6b7280;
    --light: #e5e7eb;
    --border: #1f2937;
    --surface: rgba(255, 255, 255, 0.02);
  }

  body {
    background-color: var(--dark);
    color: var(--light);
    font-family: 'Space Grotesk', sans-serif;
    line-height: 1.6;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header */
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(5, 5, 8, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    color: var(--light);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: var(--primary);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.3);
    color: white;
  }

  .btn-secondary {
    background: var(--surface);
    color: var(--light);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--light);
    border-color: var(--primary);
  }

  /* Section Styling */
  section {
    padding: 5rem 0;
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--light), var(--gray));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
  }

  .section-subtitle {
    text-align: center;
    color: var(--gray);
    font-size: 1.25rem;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* 1. Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 2rem 4rem;
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(59, 130, 246, 0.08) 0%, transparent 60%);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 2rem;
    backdrop-filter: blur(10px);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    background: linear-gradient(135deg, #ffffff, #a0a0a0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-description {
    font-size: 1.3rem;
    color: var(--gray);
    max-width: 700px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .hero-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* 2. Problem Section */
  .problem-section {
    background: var(--darker);
    padding: 6rem 0;
  }

  .problem-section h2 {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3rem;
    line-height: 1.3;
  }

  .problem-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .problem-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .problem-card:hover {
    border-color: rgba(239, 68, 68, 0.3);
  }

  .problem-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .problem-card h3 {
    color: var(--light);
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .problem-card p {
    color: var(--gray);
    line-height: 1.6;
  }

  /* 3. Transformation / Before-After */
  .transformation {
    padding: 6rem 0;
  }

  .comparison-table {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .comparison-column {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
  }

  .comparison-column.after {
    border-color: var(--primary);
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.1);
  }

  .comparison-column h3 {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    color: var(--light);
  }

  .comparison-column.after h3 {
    color: var(--primary);
  }

  .comparison-items {
    margin-bottom: 0;
  }

  .comparison-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--gray);
  }

  .comparison-item:last-child {
    border-bottom: none;
  }

  .comparison-column.before .comparison-item::before {
    content: "\2717  ";
    color: rgba(239, 68, 68, 0.6);
  }

  .comparison-column.after .comparison-item::before {
    content: "\2713  ";
    color: var(--accent);
  }

  /* 4. How It Works / Layers */
  .how-it-works {
    background: var(--darker);
    padding: 6rem 0;
  }

  .layers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .layer-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    transition: all 0.3s ease;
  }

  .layer-card:hover {
    border-color: var(--primary);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.08);
  }

  .layer-number {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    font-weight: 700;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .layer-content h3 {
    color: var(--light);
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
  }

  .layer-technical {
    font-size: 0.8rem;
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .layer-content p:last-child {
    color: var(--gray);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* 5. Proof / Benchmarks */
  .proof-section {
    padding: 6rem 0;
  }

  .proof-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .proof-stat {
    text-align: center;
    padding: 2rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .proof-stat.highlight {
    border-color: var(--accent);
    box-shadow: 0 0 30px rgba(6, 214, 160, 0.1);
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .proof-stat.highlight .stat-number {
    background: linear-gradient(135deg, var(--accent), #34d399);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-label {
    color: var(--gray);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .proof-footnote {
    text-align: center;
    color: var(--gray);
    font-size: 0.95rem;
    margin-top: 2rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    font-style: italic;
  }

  /* 6. Use Cases */
  .use-cases {
    background: var(--darker);
    padding: 6rem 0;
  }

  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .use-case {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .use-case:hover {
    border-color: var(--primary);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.1);
  }

  .use-case-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: block;
  }

  .use-case h3 {
    color: var(--light);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .use-case p {
    color: var(--gray);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .use-case-example {
    padding: 0.75rem 1rem;
    background: rgba(59, 130, 246, 0.06);
    border-left: 3px solid var(--primary);
    border-radius: 0 6px 6px 0;
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.5;
  }

  .use-case-example span {
    color: var(--primary);
    font-weight: 600;
  }

  /* 7. Learning Section */
  .learning-section {
    padding: 6rem 0;
    background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(139, 92, 246, 0.06) 0%, transparent 70%);
  }

  .learning-content {
    text-align: center;
    max-width: 750px;
    margin: 0 auto;
  }

  .learning-headline {
    font-size: 1.5rem;
