---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Dein Pitch | MachineMachine" description="Deine persoenliche MachineMachine Praesentation wird generiert.">
  <div class="pitch-page">
    <div class="pitch-container">
      <!-- Loading State -->
      <div id="state-loading" class="pitch-state">
        <a href="/" class="logo-link">M&sup2;</a>
        <div class="spinner"></div>
        <h1>Dein Pitch wird geladen...</h1>
        <p>Einen Moment bitte.</p>
      </div>

      <!-- Generating State -->
      <div id="state-generating" class="pitch-state hidden">
        <a href="/" class="logo-link">M&sup2;</a>
        <div class="spinner"></div>
        <h1>Dein Pitch wird gerade erstellt...</h1>
        <p>Wir sind fast fertig. Diese Seite aktualisiert sich automatisch.</p>
        <div class="progress-hint">Normalerweise dauert es ca. 30 Minuten.</div>
      </div>

      <!-- Ready State -->
      <div id="state-ready" class="pitch-state hidden">
        <!-- Content will be injected here -->
      </div>

      <!-- Error State -->
      <div id="state-error" class="pitch-state hidden">
        <a href="/" class="logo-link">M&sup2;</a>
        <div class="error-icon">&#x26A0;&#xFE0F;</div>
        <h1>Etwas ist schiefgelaufen</h1>
        <p id="error-message">Wir konnten deinen Pitch nicht laden. Bitte versuch es spaeter erneut.</p>
        <a href="/" class="btn btn-primary">Zurueck zur Startseite</a>
      </div>

      <!-- Not Found State -->
      <div id="state-notfound" class="pitch-state hidden">
        <a href="/" class="logo-link">M&sup2;</a>
        <h1>Pitch nicht gefunden</h1>
        <p>Dieser Link ist ungueltig oder abgelaufen.</p>
        <a href="/#pitch-form" class="btn btn-primary">Neuen Pitch anfragen</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const API_URL = (import.meta as any).env.PUBLIC_API_URL || 'https://api.machinemachine.ai';

  const stateLoading = document.getElementById('state-loading')!;
  const stateGenerating = document.getElementById('state-generating')!;
  const stateReady = document.getElementById('state-ready')!;
  const stateError = document.getElementById('state-error')!;
  const stateNotfound = document.getElementById('state-notfound')!;
  const errorMessage = document.getElementById('error-message')!;

  function showState(state: string) {
    [stateLoading, stateGenerating, stateReady, stateError, stateNotfound].forEach(el => {
      el.classList.add('hidden');
    });
    const el = document.getElementById(`state-${state}`);
    if (el) el.classList.remove('hidden');
  }

  function getUuid(): string | null {
    // Try path: /pitch/some-uuid or /pitch/some-uuid/
    const pathMatch = window.location.pathname.match(/\/pitch\/([a-zA-Z0-9_-]+)/);
    if (pathMatch) return pathMatch[1];

    // Try query param: /pitch?id=some-uuid or /pitch/?id=some-uuid
    const params = new URLSearchParams(window.location.search);
    return params.get('id');
  }

  async function checkStatus(uuid: string) {
    try {
      const res = await fetch(`${API_URL}/v1/pitch/${uuid}/status`);

      if (res.status === 404) {
        showState('notfound');
        return;
      }

      if (!res.ok) {
        throw new Error(`Status ${res.status}`);
      }

      const data = await res.json();

      if (data.status === 'generating' || data.status === 'pending' || data.status === 'queued') {
        showState('generating');
        // Auto-refresh every 30 seconds
        setTimeout(() => checkStatus(uuid), 30000);
        return;
      }

      if (data.status === 'ready' || data.status === 'completed' || data.status === 'done') {
        await loadPitch(uuid);
        return;
      }

      if (data.status === 'error' || data.status === 'failed') {
        if (data.message) errorMessage.textContent = data.message;
        showState('error');
        return;
      }

      // Unknown status — treat as generating
      showState('generating');
      setTimeout(() => checkStatus(uuid), 30000);
    } catch (err) {
      showState('error');
    }
  }

  async function loadPitch(uuid: string) {
    try {
      const res = await fetch(`${API_URL}/v1/pitch/${uuid}/html`);
      if (!res.ok) throw new Error(`Failed to load pitch: ${res.status}`);

      const html = await res.text();

      // Inject HTML into the ready state
      stateReady.innerHTML = html;
      showState('ready');

      // Apply full-width styling when pitch is ready
      const pitchPage = document.querySelector('.pitch-page') as HTMLElement;
      if (pitchPage) {
        pitchPage.style.padding = '0';
      }
      const pitchContainer = document.querySelector('.pitch-container') as HTMLElement;
      if (pitchContainer) {
        pitchContainer.style.maxWidth = 'none';
        pitchContainer.style.padding = '0';
      }
    } catch (err) {
      showState('error');
    }
  }

  // Init
  const uuid = getUuid();
  if (!uuid) {
    showState('notfound');
  } else {
    checkStatus(uuid);
  }
</script>

<style>
  :root {
    --primary: #3b82f6;
    --secondary: #8b5cf6;
    --dark: #0a0a0f;
    --gray: #6b7280;
    --light: #e5e7eb;
    --border: #1f2937;
  }

  .pitch-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--dark);
    padding: 2rem;
  }

  .pitch-container {
    max-width: 600px;
    width: 100%;
  }

  .pitch-state {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .logo-link {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .pitch-state h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--light);
    line-height: 1.3;
  }

  .pitch-state p {
    color: var(--gray);
    font-size: 1.1rem;
    max-width: 400px;
    line-height: 1.6;
  }

  .progress-hint {
    font-size: 0.9rem;
    color: var(--gray);
    opacity: 0.7;
    margin-top: 0.5rem;
  }

  .error-icon {
    font-size: 3rem;
  }

  /* Spinner */
  .spinner {
    width: 48px;
    height: 48px;
    border: 3px solid var(--border);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    margin-top: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.3);
    color: white;
  }

  .hidden {
    display: none !important;
  }
</style>
