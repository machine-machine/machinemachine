---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

// Load all weekly reports from content/reports/*.json
const reportsDir = join(process.cwd(), 'src/data/reports');
let reports: any[] = [];
try {
  const files = readdirSync(reportsDir).filter(f => f.endsWith('.json')).sort().reverse();
  reports = files.map(f => {
    const data = JSON.parse(readFileSync(join(reportsDir, f), 'utf-8'));
    return { ...data, slug: f.replace('.json', '') };
  });
} catch (e) {
  console.error('Could not load reports:', e);
}

const latest = reports[0];

function scoreColor(s: number) {
  if (s >= 75) return '#4ade80';
  if (s >= 50) return '#fbbf24';
  return '#f87171';
}

function trendArrow(curr: number, prev: number | undefined) {
  if (prev === undefined) return '';
  if (curr > prev) return '↑';
  if (curr < prev) return '↓';
  return '→';
}

function trendColor(curr: number, prev: number | undefined) {
  if (prev === undefined) return '#64748b';
  if (curr > prev) return '#4ade80';
  if (curr < prev) return '#f87171';
  return '#64748b';
}
---

<BaseLayout title="Weekly Report | Machine.Machine" description="Internal weekly system report tracking fleet health, memory system, org builder progress, and evolution roadmap.">
  <style>
    * { box-sizing: border-box; }
    .report-page { background: #0a0a12; min-height: 100vh; color: #e2e8f0; font-family: 'Space Grotesk', system-ui, sans-serif; }
    
    .report-hero { 
      background: linear-gradient(135deg, #0a0a12 0%, #13003a 50%, #0a0a12 100%);
      border-bottom: 1px solid #1e1e38;
      padding: 56px 48px 40px;
    }
    .report-hero .tag { 
      display: inline-block; padding: 4px 12px; background: rgba(124,58,237,0.15); 
      border: 1px solid rgba(124,58,237,0.3); border-radius: 999px; 
      font-size: 0.75rem; font-weight: 600; color: #a78bfa; letter-spacing: 0.08em;
      text-transform: uppercase; margin-bottom: 16px;
    }
    .report-hero h1 { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 8px; }
    .report-hero h1 span { color: #a78bfa; }
    .report-hero p { color: #64748b; font-size: 0.95rem; max-width: 600px; }
    
    .report-container { max-width: 1200px; margin: 0 auto; padding: 40px 48px; }
    
    /* Score overview */
    .score-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 40px; }
    .score-card { background: #10101e; border: 1px solid #1e1e38; border-radius: 12px; padding: 20px; text-align: center; }
    .score-card .label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: #64748b; font-weight: 600; margin-bottom: 10px; }
    .score-card .val { font-size: 2.4rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
    .score-card .sub { font-size: 0.78rem; color: #64748b; margin-top: 4px; }
    .score-card .trend { font-size: 0.8rem; font-weight: 700; margin-top: 6px; }
    
    /* Radar viz */
    .subsystems { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
    .subsystem-bar { margin-bottom: 14px; }
    .subsystem-bar .row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 0.85rem; }
    .subsystem-bar .name { font-weight: 500; }
    .subsystem-bar .pct { font-weight: 700; }
    .bar-track { height: 8px; background: #1a1a2e; border-radius: 999px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 999px; }
    
    /* Weeks history */
    .weeks-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .week-card { 
      background: #10101e; border: 1px solid #1e1e38; border-radius: 12px; 
      padding: 20px; text-decoration: none; color: inherit;
      transition: border-color 0.2s, transform 0.2s;
      display: block;
    }
    .week-card:hover { border-color: #7c3aed; transform: translateY(-2px); }
    .week-card.current { border-color: rgba(124,58,237,0.5); background: linear-gradient(135deg, #10101e, #13003a20); }
    .week-card .wc-date { font-size: 0.75rem; color: #64748b; margin-bottom: 6px; }
    .week-card .wc-title { font-size: 1rem; font-weight: 700; margin-bottom: 10px; }
    .week-card .wc-score-row { display: flex; align-items: center; gap: 10px; }
    .week-card .wc-score { font-size: 1.6rem; font-weight: 800; }
    .week-card .wc-bars { flex: 1; display: flex; flex-direction: column; gap: 4px; }
    .week-card .mini-bar { height: 4px; background: #1a1a2e; border-radius: 999px; overflow: hidden; }
    .week-card .mini-fill { height: 100%; border-radius: 999px; }
    .week-card .wc-shipped { font-size: 0.75rem; color: #64748b; margin-top: 10px; }
    .week-card .wc-shipped strong { color: #4ade80; }
    .week-card .wc-tag { display: inline-block; font-size: 0.65rem; padding: 2px 8px; border-radius: 999px; background: rgba(124,58,237,0.15); color: #a78bfa; border: 1px solid rgba(124,58,237,0.2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
    
    /* Gap list */
    .gap-row { display: flex; gap: 12px; padding: 14px 0; border-bottom: 1px solid #1e1e38; }
    .gap-row:last-child { border-bottom: none; }
    .gap-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
    .gap-content h4 { font-size: 0.9rem; font-weight: 600; margin-bottom: 2px; }
    .gap-content p { font-size: 0.8rem; color: #64748b; }
    
    /* Shipped list */
    .shipped-item { display: flex; gap: 10px; padding: 8px 0; font-size: 0.88rem; border-bottom: 1px solid rgba(30,30,56,0.5); }
    .shipped-item:last-child { border-bottom: none; }
    .shipped-item::before { content: "✅"; flex-shrink: 0; }
    
    /* Section */
    .section { margin-bottom: 48px; }
    .section-hdr { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; border-bottom: 1px solid #1e1e38; padding-bottom: 12px; }
    .section-hdr h2 { font-size: 1.1rem; font-weight: 700; }
    .section-hdr span { font-size: 0.8rem; color: #64748b; }
    
    .card { background: #10101e; border: 1px solid #1e1e38; border-radius: 12px; padding: 24px; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    
    /* Footer */
    .report-footer { border-top: 1px solid #1e1e38; padding: 24px 48px; color: #475569; font-size: 0.8rem; display: flex; justify-content: space-between; max-width: 1200px; margin: 0 auto; }
    
    @media (max-width: 768px) {
      .report-hero, .report-container, .report-footer { padding-left: 20px; padding-right: 20px; }
      .score-grid, .subsystems, .grid-2 { grid-template-columns: 1fr; }
      .report-hero h1 { font-size: 1.8rem; }
    }
    
    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 9999px; font-size: 0.72rem; font-weight: 600; }
    .badge-red { background: rgba(248,113,113,0.1); color: #f87171; border: 1px solid rgba(248,113,113,0.2); }
    .badge-yellow { background: rgba(251,191,36,0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }
    .badge-green { background: rgba(74,222,128,0.1); color: #4ade80; border: 1px solid rgba(74,222,128,0.2); }
  </style>

  <div class="report-page">
    <div class="report-hero">
      <div class="tag">⚡ Internal · Eyes Only</div>
      <h1>Machine<span>.Machine</span><br/>Weekly System Report</h1>
      <p>Every Friday at 22:00 UTC, m2 audits the entire fleet — health, memory, org builder, comms, gaps, and evolution plan. This is the live record.</p>
    </div>

    <div class="report-container">

      {latest && (
        <>
          <!-- TOP SCORES -->
          <section class="section">
            <div class="section-hdr">
              <h2>📊 Latest Week — {latest.date}</h2>
              <span>{latest.title}</span>
            </div>
            <div class="score-grid">
              <div class="score-card" style={`border-color: ${scoreColor(latest.overall)}40`}>
                <div class="label">Overall Readiness</div>
                <div class="val" style={`color: ${scoreColor(latest.overall)}`}>{latest.overall}%</div>
                <div class="sub">Production grade</div>
              </div>
              <div class="score-card">
                <div class="label">Active Agents</div>
                <div class="val" style="color: #4ade80">{latest.fleet.agentsHealthy}</div>
                <div class="sub">/ {latest.fleet.agentsHealthy + latest.fleet.agentsDegraded} deployed</div>
              </div>
              <div class="score-card">
                <div class="label">Memory Vectors</div>
                <div class="val" style="color: #a78bfa">{latest.fleet.memoryVectors.toLocaleString()}+</div>
                <div class="sub">Qdrant semantic index</div>
              </div>
              <div class="score-card">
                <div class="label">Shipped This Week</div>
                <div class="val" style="color: #60a5fa">{latest.shipped.length}</div>
                <div class="sub">features / fixes / infra</div>
              </div>
            </div>

            <!-- SUBSYSTEM SCORES -->
            <div class="subsystems">
              <div class="card">
                <div style="font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#64748b; margin-bottom:16px;">Subsystem Readiness</div>
                {Object.entries(latest.scores).map(([key, val]: [string, any]) => {
                  const labels: Record<string, string> = {
                    fleetManagement: 'Fleet Management',
                    memorySystem: 'Memory System',
                    orgBuilder: 'Autonomous Org Builder',
                    commsProtocol: 'Communication Protocols',
                    playbookAdoption: 'Playbook Adoption',
                    resourceProvisioning: 'Resource Provisioning',
                    roleSystem: 'Role / Org Science',
                    darkFactory: 'Dark Factory Engine'
                  };
                  return (
                    <div class="subsystem-bar">
                      <div class="row">
                        <span class="name">{labels[key] || key}</span>
                        <span class="pct" style={`color: ${scoreColor(val)}`}>{val}%</span>
                      </div>
                      <div class="bar-track">
                        <div class="bar-fill" style={`width: ${val}%; background: ${scoreColor(val)}`}></div>
                      </div>
                    </div>
                  );
                })}
              </div>

              <div style="display: flex; flex-direction: column; gap: 16px;">
                <div class="card" style="flex:1">
                  <div style="font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#64748b; margin-bottom:12px;">🚀 Shipped</div>
                  {latest.shipped.slice(0, 6).map((item: string) => (
                    <div class="shipped-item">{item}</div>
                  ))}
                  {latest.shipped.length > 6 && (
                    <div style="font-size:0.78rem; color:#64748b; margin-top:8px;">+ {latest.shipped.length - 6} more</div>
                  )}
                </div>
                <div class="card">
                  <div style="font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#64748b; margin-bottom:10px;">🚫 Blocked</div>
                  {latest.blocked.map((item: string) => (
                    <div style="font-size:0.85rem; color:#f87171; padding: 4px 0; display: flex; gap: 8px;">
                      <span>🔴</span><span>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- TOP GAPS -->
            <div class="card">
              <div style="font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#64748b; margin-bottom:12px;">🔍 Critical Gaps</div>
              {latest.topGaps.filter((g: any) => g.severity === 'critical').map((gap: any) => (
                <div class="gap-row">
                  <div class="gap-dot" style="background: #f87171"></div>
                  <div class="gap-content">
                    <h4>{gap.title}</h4>
                    <p>{gap.description}</p>
                  </div>
                  <span class="badge badge-red" style="flex-shrink:0; align-self:flex-start">{gap.severity}</span>
                </div>
              ))}
              {latest.topGaps.filter((g: any) => g.severity === 'warning').map((gap: any) => (
                <div class="gap-row">
                  <div class="gap-dot" style="background: #fbbf24"></div>
                  <div class="gap-content">
                    <h4>{gap.title}</h4>
                    <p>{gap.description}</p>
                  </div>
                  <span class="badge badge-yellow" style="flex-shrink:0; align-self:flex-start">{gap.severity}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- NEXT ACTIONS -->
          <section class="section">
            <div class="section-hdr">
              <h2>⚡ Top Actions This Week</h2>
            </div>
            <div class="card">
              {latest.nextActions.map((action: string, i: number) => (
                <div style="display:flex; gap:12px; padding:10px 0; border-bottom: 1px solid #1e1e38; font-size:0.88rem;">
                  <span style="color:#7c3aed; font-weight:700; min-width:20px">{i + 1}.</span>
                  <span>{action}</span>
                </div>
              ))}
            </div>
          </section>
        </>
      )}

      <!-- ALL WEEKLY REPORTS ARCHIVE -->
      <section class="section">
        <div class="section-hdr">
          <h2>📅 Weekly Report Archive</h2>
          <span>Every Friday — click to explore · <a href="/report/repos" style="color:#a78bfa; text-decoration:none;">🗂️ Repo Map →</a></span>
        </div>
        <div class="weeks-grid">
          {reports.map((report: any, i: number) => (
            <a href={`/report/${report.slug}`} class={`week-card ${i === 0 ? 'current' : ''}`}>
              {i === 0 && <div class="wc-tag">Latest</div>}
              <div class="wc-date">Week {report.week} · {report.date}</div>
              <div class="wc-title">{report.title}</div>
              <div class="wc-score-row">
                <div class="wc-score" style={`color: ${scoreColor(report.overall)}`}>{report.overall}%</div>
                <div class="wc-bars">
                  {Object.values(report.scores as Record<string, number>).slice(0, 4).map((s) => (
                    <div class="mini-bar">
                      <div class="mini-fill" style={`width:${s}%; background:${scoreColor(s)}`}></div>
                    </div>
                  ))}
                </div>
              </div>
              <div class="wc-shipped"><strong>{report.shipped.length}</strong> shipped · <span style="color:#f87171">{report.blocked.length} blocked</span></div>
            </a>
          ))}
          {reports.length === 0 && (
            <div class="card" style="color:#64748b; font-size:0.9rem;">No reports yet. First report generates this Friday.</div>
          )}
        </div>
      </section>

      <!-- EVOLUTION PHASES -->
      <section class="section">
        <div class="section-hdr">
          <h2>🗺️ Evolution Roadmap</h2>
          <span>4 phases to self-evolving production system</span>
        </div>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
          {[
            { phase: 0, label: 'Foundation', status: 'done', items: ['7 agents deployed', 'Voice, memory, tasks', 'Spawn pipeline', 'Fleet Playbook v0.2', 'Resource provisioning'] },
            { phase: 1, label: 'Coherence', status: 'active', items: ['Playbook fleet-wide', 'Fleet heartbeat bus', 'API keys provisioned', 'Conversation archiving', 'CI/CD fixed'] },
            { phase: 2, label: 'Intelligence', status: 'future', items: ['Org-level memory', 'Per-user memory', 'Capability registry', 'AIEOS roles', 'ACP wiring'] },
            { phase: 3, label: 'Dark Factory', status: 'future', items: ['Gap detection agent', 'Workflow synthesis', 'Closed CI/CD loop', 'Auto-governance', 'Cost attribution'] },
          ].map(p => (
            <div style={`background: #10101e; border: 1px solid ${p.status === 'done' ? '#4ade8040' : p.status === 'active' ? '#7c3aed40' : '#1e1e38'}; border-radius: 12px; padding: 20px; border-top: 3px solid ${p.status === 'done' ? '#4ade80' : p.status === 'active' ? '#7c3aed' : '#1e1e38'};`}>
              <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:#64748b; margin-bottom:4px;">Phase {p.phase}</div>
              <div style="font-weight:700; margin-bottom:12px; font-size:1rem;">{p.label}</div>
              {p.items.map(item => (
                <div style="font-size:0.8rem; color:#94a3b8; padding:3px 0; display:flex; gap:6px;">
                  <span style={`color:${p.status === 'done' ? '#4ade80' : p.status === 'active' ? '#a78bfa' : '#475569'}`}>
                    {p.status === 'done' ? '✓' : p.status === 'active' ? '→' : '○'}
                  </span>
                  {item}
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>

    </div>

    <div class="report-footer">
      <span>⚡ Machine.Machine Internal Report · Generated by m2 (orchestrator) · Every Friday 22:00 UTC</span>
      <span>Not indexed · Internal only</span>
    </div>
  </div>
</BaseLayout>
