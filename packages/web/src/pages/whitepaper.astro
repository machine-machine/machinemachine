    color: #00f0ff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  th, td {
    padding: 0.75rem;
    text-align: left;
